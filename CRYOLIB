local CryoLib = {}

function CryoLib:CreateWindow(hubName)
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    local libData = {
        tabs = {},
        accent = Color3.fromRGB(100, 150, 255)
    }

    -- [[ ГЛАВНЫЙ GUI ]]
    local gui = Instance.new("ScreenGui")
    gui.Name = "CryoLib_Official"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- [[ ПЛАВАЮЩАЯ КНОПКА ]]
    local floatBtn = Instance.new("ImageButton")
    floatBtn.Name = "CryoMobileBtn"
    floatBtn.Size = UDim2.new(0, 50, 0, 50)
    floatBtn.Position = UDim2.new(0, 20, 0.5, -25)
    floatBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    -- ВСТАВЬ СВОЙ ID НИЖЕ:
    floatBtn.Image = "rbxassetid://104331218636380" 
    floatBtn.Parent = gui
    
    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(1, 0)
    fCorner.Parent = floatBtn
    
    local floatStroke = Instance.new("UIStroke")
    floatStroke.Color = libData.accent
    floatStroke.Thickness = 2
    floatStroke.Parent = floatBtn

    -- Драг для плавающей кнопки
    local fDrag = false
    local fS, fP
    floatBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            fDrag = true
            fS = i.Position
            fP = floatBtn.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if fDrag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - fS
            floatBtn.Position = UDim2.new(fP.X.Scale, fP.X.Offset + d.X, fP.Y.Scale, fP.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = false end
    end)

    -- [[ ГЛАВНАЯ ПАНЕЛЬ ]]
    local mainPanel = Instance.new("Frame")
    mainPanel.Name = "MainFrame"
    mainPanel.Size = UDim2.new(0, 420, 0, 520)
    mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    mainPanel.Visible = false 
    mainPanel.Parent = gui
    
    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 20)
    mCorner.Parent = mainPanel
    
    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = Color3.fromRGB(45, 45, 55)
    mainStroke.Thickness = 2
    mainStroke.Parent = mainPanel

    floatBtn.MouseButton1Click:Connect(function()
        mainPanel.Visible = not mainPanel.Visible
    end)

    -- [[ HEADER ]]
    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 50)
    header.BackgroundTransparency = 1
    header.Parent = mainPanel

    local function makeDraggable(obj, parent)
        local dragging, startPos, startInput
        obj.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                startInput = i.Position
                startPos = parent.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = i.Position - startInput
                parent.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end
    makeDraggable(header, mainPanel)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -100, 1, 0)
    title.Position = UDim2.new(0, 20, 0, 0)
    title.Text = hubName
    title.Font = Enum.Font.GothamBlack
    title.TextColor3 = Color3.new(1,1,1)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextSize = 18
    title.BackgroundTransparency = 1
    title.Parent = header

    -- [[ КОНТЕЙНЕРЫ ]]
    local tabContainer = Instance.new("Frame")
    tabContainer.Size = UDim2.new(0, 100, 1, -50)
    tabContainer.Position = UDim2.new(0, 0, 0, 50)
    tabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    tabContainer.BorderSizePixel = 0
    tabContainer.Parent = mainPanel
    
    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(0, 20)
    tCorner.Parent = tabContainer

    local contentArea = Instance.new("Frame")
    contentArea.Size = UDim2.new(1, -100, 1, -50)
    contentArea.Position = UDim2.new(0, 100, 0, 50)
    contentArea.BackgroundTransparency = 1
    contentArea.Parent = mainPanel

    function libData:CreateTab(name)
        local tabObj = {}
        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, -20, 1, -20)
        scroll.Position = UDim2.new(0, 10, 0, 10)
        scroll.Visible = false
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 2
        scroll.ScrollBarImageColor3 = libData.accent
        scroll.Parent = contentArea
        
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.Parent = scroll
        
        layout.Changed:Connect(function() 
            scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10) 
        end)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 40)
        btn.Position = UDim2.new(0, 0, 0, #libData.tabs * 42)
        btn.Text = name
        btn.BackgroundTransparency = 1
        btn.TextColor3 = Color3.new(0.5,0.5,0.5)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 13
        btn.Parent = tabContainer

        btn.MouseButton1Click:Connect(function()
            for _, t in ipairs(libData.tabs) do 
                t.s.Visible = false
                t.b.TextColor3 = Color3.new(0.5,0.5,0.5) 
            end
            scroll.Visible = true
            btn.TextColor3 = Color3.new(1,1,1)
        end)

        table.insert(libData.tabs, {s = scroll, b = btn})
        if #libData.tabs == 1 then 
            scroll.Visible = true 
            btn.TextColor3 = Color3.new(1,1,1) 
        end

        function tabObj:CreateLabel(txt)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, 0, 0, 25)
            l.Text = txt
            l.TextColor3 = libData.accent
            l.Font = Enum.Font.GothamBold
            l.BackgroundTransparency = 1
            l.TextSize = 14
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = scroll
        end

        function tabObj:CreateToggle(txt, callback)
            local state = false
            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, -5, 0, 45)
            f.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            f.Parent = scroll
            local fc = Instance.new("UICorner")
            fc.CornerRadius = UDim.new(0, 8)
            fc.Parent = f
            
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, -60, 1, 0)
            l.Position = UDim2.new(0, 12, 0, 0)
            l.Text = txt
            l.Font = Enum.Font.GothamBold
            l.TextColor3 = Color3.new(1,1,1)
            l.BackgroundTransparency = 1
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.TextSize = 14
            l.Parent = f
            
            local bg = Instance.new("Frame")
            bg.Size = UDim2.new(0, 38, 0, 20)
            bg.Position = UDim2.new(1, -48, 0.5, -10)
            bg.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            bg.Parent = f
            local bgc = Instance.new("UICorner")
            bgc.CornerRadius = UDim.new(1, 0)
            bgc.Parent = bg
            
            local c = Instance.new("Frame")
            c.Size = UDim2.new(0, 16, 0, 16)
            c.Position = UDim2.new(0, 2, 0.5, -8)
            c.BackgroundColor3 = Color3.new(1,1,1)
            c.Parent = bg
            local cc = Instance.new("UICorner")
            cc.CornerRadius = UDim.new(1, 0)
            cc.Parent = c
            
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 1, 0)
            b.BackgroundTransparency = 1
            b.Text = ""
            b.Parent = f
            
            b.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(bg, TweenInfo.new(0.3), {BackgroundColor3 = state and libData.accent or Color3.fromRGB(45, 45, 55)}):Play()
                TweenService:Create(c, TweenInfo.new(0.3), {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                callback(state)
            end)
        end

        function tabObj:CreateSlider(txt, min, max, def, callback)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, -5, 0, 60)
            f.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            f.Parent = scroll
            local fc = Instance.new("UICorner")
            fc.CornerRadius = UDim.new(0, 8)
            fc.Parent = f
            
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, -20, 0, 20)
            l.Position = UDim2.new(0, 12, 0, 8)
            l.Text = txt .. ": " .. def
            l.Font = Enum.Font.GothamBold
            l.TextColor3 = Color3.new(1,1,1)
            l.BackgroundTransparency = 1
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.TextSize = 14
            l.Parent = f
            
            local t = Instance.new("Frame")
            t.Size = UDim2.new(1, -30, 0, 6)
            t.Position = UDim2.new(0, 15, 0, 38)
            t.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            t.Parent = f
            local tc = Instance.new("UICorner")
            tc.CornerRadius = UDim.new(1, 0)
            tc.Parent = t
            
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((def-min)/(max-min), 0, 1, 0)
            fill.BackgroundColor3 = libData.accent
            fill.Parent = t
            local fillc = Instance.new("UICorner")
            fillc.CornerRadius = UDim.new(1, 0)
            fillc.Parent = fill
            
            local function update()
                local mousePos = UserInputService:GetMouseLocation().X
                local barPos = t.AbsolutePosition.X
                local barSize = t.AbsoluteSize.X
                local m = math.clamp((mousePos - barPos) / barSize, 0, 1)
                local val = math.floor(min + (m * (max - min)))
                l.Text = txt .. ": " .. val
                fill.Size = UDim2.new(m, 0, 1, 0)
                callback(val)
            end

            t.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    local move
                    move = UserInputService.InputChanged:Connect(function(ev)
                        if ev.UserInputType == Enum.UserInputType.MouseMovement then update() end
                    end)
                    UserInputService.InputEnded:Connect(function(ev)
                        if ev.UserInputType == Enum.UserInputType.MouseButton1 then 
                            if move then move:Disconnect() end
                        end
                    end)
                    update()
                end
            end)
        end

        function tabObj:CreateButton(txt, callback)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -5, 0, 40)
            b.BackgroundColor3 = libData.accent
            b.Text = txt
            b.Font = Enum.Font.GothamBlack
            b.TextColor3 = Color3.new(1,1,1)
            b.TextSize = 14
            b.Parent = scroll
            local bc = Instance.new("UICorner")
            bc.CornerRadius = UDim.new(0, 10)
            bc.Parent = b
            b.MouseButton1Click:Connect(callback)
        end

        return tabObj
    end
    return libData
end

return CryoLib
