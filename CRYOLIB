end

function CryoLib:SetupDragging()
	local isDragging = false
	local dragStartMouse = nil
	local dragStartFramePos = nil

	self.header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
			dragStartFramePos = self.mainPanel.AbsolutePosition
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartMouse
			if self.mainPanel and self.mainPanel.Parent then
				self.mainPanel.Position = UDim2.new(0, dragStartFramePos.X + delta.X, 0, dragStartFramePos.Y + delta.Y)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)
end

function CryoLib:ToggleMinimize()
	if self._destroyed or not self.mainPanel or not self.mainPanel.Parent then return end
	
	self.minimized = not self.minimized
	if self.minimized then
		if self.contentArea and self.contentArea.Parent then self.contentArea.Visible = false end
		if self.tabContainer and self.tabContainer.Parent then self.tabContainer.Visible = false end
		local tween = SafeTween(self.mainPanel, TweenInfo.new(0.3), {Size = UDim2.new(0, 420, 0, 50)})
		if tween then tween:Play() end
	else
		if self.contentArea and self.contentArea.Parent then self.contentArea.Visible = true end
		if self.tabContainer and self.tabContainer.Parent then self.tabContainer.Visible = true end
		local tween = SafeTween(self.mainPanel, TweenInfo.new(0.3), {Size = self.originalSize})
		if tween then tween:Play() end
	end
end

function CryoLib:SetupHotkey()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and input.KeyCode == Enum.KeyCode.K then
			self:Toggle()
		end
	end)
end

function CryoLib:Toggle()
	if self._destroyed then return end
	if not self.mainPanel or not self.mainPanel.Parent then return end
	
	self.isOpen = not self.isOpen

	if self.isOpen then
		self.minimized = false
		if self.contentArea and self.contentArea.Parent then self.contentArea.Visible = true end
		if self.tabContainer and self.tabContainer.Parent then self.tabContainer.Visible = true end
		
		local targetSize = self.originalSize or UDim2.new(0, 420, 0, 520)
		local targetPos = UDim2.new(0.5, -210, 0.5, -260)
		
		self.mainPanel.Visible = true
		self.mainPanel.Size = UDim2.new(0, 0, 0, 0)
		self.mainPanel.Position = UDim2.new(0.5, 0, 0.5, 0)
		
		local tween = SafeTween(self.mainPanel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = targetSize,
			Position = targetPos
		})
		if tween then tween:Play() end
	else
		local tween = SafeTween(self.mainPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		})
		if tween then 
			tween:Play()
			tween.Completed:Connect(function()
				if self._destroyed then return end
				if self.mainPanel and self.mainPanel.Parent then
					self.mainPanel.Visible = false
					self.mainPanel.Size = self.originalSize or UDim2.new(0, 420, 0, 520)
					self.mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
				end
			end)
		else
			-- Если твин не создался, просто скрываем
			if self.mainPanel and self.mainPanel.Parent then
				self.mainPanel.Visible = false
			end
		end
	end
end

-- ==================== UI ЭЛЕМЕНТЫ ====================
function CryoLib:AddTab(name)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(1, 0, 0, 40)
	tabBtn.BackgroundTransparency = 1
	tabBtn.Text = name
	tabBtn.Font = Enum.Font.GothamBold
	tabBtn.TextSize = 13
	tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
	tabBtn.Parent = self.tabContainer
	tabBtn.LayoutOrder = #self.tabs

	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 3, 0, 20)
	indicator.Position = UDim2.new(0, 0, 0.5, -10)
	indicator.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
	indicator.BackgroundTransparency = 1
	indicator.BorderSizePixel = 0
	indicator.Parent = tabBtn

	local tabData = {btn = tabBtn, indicator = indicator, name = name, elements = {}}
	table.insert(self.tabs, tabData)

	tabBtn.MouseButton1Click:Connect(function() self:ActivateTab(tabData) end)

	if #self.tabs == 1 then self:ActivateTab(tabData) end

	return {
		AddSection = function(sectionName)
			return self:AddSectionToTab(tabData, sectionName)
		end
	}
end

function CryoLib:ActivateTab(tabData)
	if self._destroyed then return end

	for _, t in ipairs(self.tabs) do
		if t.btn and t.btn.Parent then
			TweenService:Create(t.btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
		end
		if t.indicator and t.indicator.Parent then
			TweenService:Create(t.indicator, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
		end
		for _, elem in ipairs(t.elements) do
			if elem and elem.Parent then elem.Visible = false end
		end
	end

	if tabData.btn and tabData.btn.Parent then
		TweenService:Create(tabData.btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
	end
	if tabData.indicator and tabData.indicator.Parent then
		TweenService:Create(tabData.indicator, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
	end

	for _, elem in ipairs(tabData.elements) do
		if elem and elem.Parent then elem.Visible = true end
	end
end

function CryoLib:AddSectionToTab(tabData, sectionName)
	local section = Instance.new("TextLabel")
	section.Size = UDim2.new(1, -10, 0, 25)
	section.BackgroundTransparency = 1
	section.Text = tostring(sectionName)
	section.Font = Enum.Font.GothamBold
	section.TextSize = 14
	section.TextColor3 = Color3.fromRGB(100, 150, 255)
	section.TextXAlignment = Enum.TextXAlignment.Left
	section.LayoutOrder = #tabData.elements
	section.Parent = self.scrollFrame
	section.Visible = false
	table.insert(tabData.elements, section)

	return {
		AddToggle = function(text, callback) return self:AddToggleToTab(tabData, text, callback) end,
		AddSlider = function(text, min, max, callback) return self:AddSliderToTab(tabData, text, min, max, callback) end,
		AddButton = function(text, callback) return self:AddButtonToTab(tabData, text, callback) end,
		AddLabel = function(text) return self:AddLabelToTab(tabData, text) end,
		AddDropdown = function(text, options, callback) return self:AddDropdownToTab(tabData, text, options, callback) end,
		AddTextBox = function(text, placeholder, callback) return self:AddTextBoxToTab(tabData, text, placeholder, callback) end
	}
end

function CryoLib:AddButtonToTab(tabData, text, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 40)
	btn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
	btn.BorderSizePixel = 0
	btn.Text = tostring(text)
	btn.Font = Enum.Font.GothamBlack
	btn.TextSize = 15
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.LayoutOrder = #tabData.elements
	btn.Parent = self.scrollFrame
	btn.Visible = false
	table.insert(tabData.elements, btn)

	local corner = Instance.new("UICorner")
