function CryoLib:CreateTabContainer()
    self.tabContainer = Instance.new("Frame")
    self.tabContainer.Name = "TabContainer"
    self.tabContainer.Size = UDim2.new(0, 100, 1, -45)
    self.tabContainer.Position = UDim2.new(0, 0, 0, 45)
    self.tabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    self.tabContainer.BorderSizePixel = 0
    self.tabContainer.Parent = self.mainPanel

    self.tabListLayout = Instance.new("UIListLayout")
    self.tabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    self.tabListLayout.Padding = UDim.new(0, 2)
    self.tabListLayout.Parent = self.tabContainer
end

function CryoLib:CreateContentArea()
    self.contentArea = Instance.new("Frame")
    self.contentArea.Name = "ContentArea"
    self.contentArea.Size = UDim2.new(1, -100, 1, -45)
    self.contentArea.Position = UDim2.new(0, 100, 0, 45)
    self.contentArea.BackgroundTransparency = 1
    self.contentArea.Parent = self.mainPanel

    self.scrollFrame = Instance.new("ScrollingFrame")
    self.scrollFrame.Size = UDim2.new(1, -15, 1, -15)
    self.scrollFrame.Position = UDim2.new(0, 7, 0, 7)
    self.scrollFrame.BackgroundTransparency = 1
    self.scrollFrame.BorderSizePixel = 0
    self.scrollFrame.ScrollBarThickness = 2
    self.scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 150, 255)
    self.scrollFrame.Parent = self.contentArea

    self.scrollLayout = Instance.new("UIListLayout")
    self.scrollLayout.Padding = UDim.new(0, 7)
    self.scrollLayout.Parent = self.scrollFrame
    self.scrollLayout.Changed:Connect(function()
        self.scrollFrame.CanvasSize = UDim2.new(0, 0, 0, self.scrollLayout.AbsoluteContentSize.Y + 10)
    end)
end

function CryoLib:SetupDragging()
    local isDragging, dragInput, dragStart, startPos
    self.header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            dragStart = input.Position
            startPos = self.mainPanel.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            self.mainPanel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
    end)
end

function CryoLib:Toggle()
    self.isOpen = not self.isOpen
    self.mainPanel.Visible = self.isOpen
end

function CryoLib:SetupHotkey()
    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.RightShift then
            self:Toggle()
        end
    end)
end

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 35)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = name
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.Parent = self.tabContainer

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 1, 0)
    indicator.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    indicator.Visible = false
    indicator.Parent = tabBtn

    local tabData = {btn = tabBtn, indicator = indicator, elements = {}}
    table.insert(self.tabs, tabData)

    tabBtn.MouseButton1Click:Connect(function()
        self:ActivateTab(tabData)
    end)

    if #self.tabs == 1 then self:ActivateTab(tabData) end

    return {
        AddButton = function(_, text, callback)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -5, 0, 35)
            btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            btn.Text = text
            btn.Font = Enum.Font.GothamSemibold
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextSize = 14
            btn.Parent = self.scrollFrame
            btn.Visible = false
            
            local bc = Instance.new("UICorner")
            bc.CornerRadius = UDim.new(0, 6)
            bc.Parent = btn

            btn.MouseButton1Click:Connect(function() SafeCall(callback) end)
            table.insert(tabData.elements, btn)
            return btn
        end
    }
end

function CryoLib:ActivateTab(tabData)
    for _, t in ipairs(self.tabs) do
        t.indicator.Visible = false
        t.btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        for _, elem in ipairs(t.elements) do elem.Visible = false end
    end
    tabData.indicator.Visible = true
    tabData.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    for _, elem in ipairs(tabData.elements) do elem.Visible = true end
end

function CryoLib:CreateFloatingButton()
    local float = Instance.new("ImageButton")
    float.Size = UDim2.new(0, 50, 0, 50)
    float.Position = UDim2.new(0, 20, 0.5, -25)
    float.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    float.Image = "rbxassetid://9751678226" -- Иконка Cryo
    float.Parent = self.gui
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = float

    float.MouseButton1Click:Connect(function() self:Toggle() end)
end

function CryoLib:Destroy()
    self.gui:Destroy()
    self._destroyed = true
end

return CryoLib
