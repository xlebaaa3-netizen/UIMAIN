-- ==================== CRYO LIBRARY (CLASSIC UI + LOGO + FLOAT) ====================
local CryoLib = {}
CryoLib.__index = CryoLib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function QuickTween(obj, prop, time)
    TweenService:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad), prop):Play()
end

function CryoLib:CreateWindow(titleText)
    local self = setmetatable({}, CryoLib)
    self.isOpen = true
    
    -- ScreenGui
    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "CryoLibGUI_" .. math.random(100, 999)
    self.gui.ResetOnSpawn = false
    self.gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- MainPanel
    self.mainPanel = Instance.new("Frame")
    self.mainPanel.Size = UDim2.new(0, 420, 0, 520)
    self.mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    self.mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    self.mainPanel.BorderSizePixel = 0
    self.mainPanel.Active = true
    self.mainPanel.Visible = true
    self.mainPanel.ClipsDescendants = true
    self.mainPanel.Parent = self.gui

    Instance.new("UICorner", self.mainPanel).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", self.mainPanel)
    stroke.Color = Color3.fromRGB(60, 60, 80)
    stroke.Thickness = 1.5

    -- Header
    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 50)
    header.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    header.BorderSizePixel = 0
    header.Parent = self.mainPanel
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 12)

    -- ФОТО В ЗАГОЛОВКЕ
    local logo = Instance.new("ImageLabel")
    logo.Size = UDim2.new(0, 35, 0, 35)
    logo.Position = UDim2.new(0, 10, 0.5, -17)
    logo.BackgroundTransparency = 1
    logo.Image = "rbxassetid://75309286909772" -- Твой ID
    logo.Parent = header
    Instance.new("UICorner", logo).CornerRadius = UDim.new(0, 6)

    local headerTitle = Instance.new("TextLabel")
    headerTitle.Size = UDim2.new(0, 200, 1, 0)
    headerTitle.Position = UDim2.new(0, 55, 0, 0) -- Сдвинул текст вправо от фото
    headerTitle.BackgroundTransparency = 1
    headerTitle.Text = titleText or "Cryo Hub"
    headerTitle.Font = Enum.Font.GothamBlack
    headerTitle.TextSize = 20
    headerTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    headerTitle.TextXAlignment = Enum.TextXAlignment.Left
    headerTitle.Parent = header

    -- TabContainer
    self.tabContainer = Instance.new("Frame")
    self.tabContainer.Size = UDim2.new(0, 100, 1, -50)
    self.tabContainer.Position = UDim2.new(0, 0, 0, 50)
    self.tabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    self.tabContainer.Parent = self.mainPanel
    Instance.new("UIListLayout", self.tabContainer).SortOrder = Enum.SortOrder.LayoutOrder

    self.contentArea = Instance.new("Frame")
    self.contentArea.Size = UDim2.new(1, -100, 1, -50)
    self.contentArea.Position = UDim2.new(0, 100, 0, 50)
    self.contentArea.BackgroundTransparency = 1
    self.contentArea.Parent = self.mainPanel

    -- ПЛАВАЮЩАЯ КНОПКА (FLOAT)
    local float = Instance.new("ImageButton")
    float.Name = "CryoFloat"
    float.Size = UDim2.new(0, 55, 0, 55)
    float.Position = UDim2.new(0, 20, 0.5, -27)
    float.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    float.Image = "rbxassetid://75309286909772"
    float.Parent = self.gui
    Instance.new("UICorner", float).CornerRadius = UDim.new(1, 0)
    local fStroke = Instance.new("UIStroke", float)
    fStroke.Color = Color3.fromRGB(100, 150, 255)
    fStroke.Thickness = 2

    float.MouseButton1Click:Connect(function()
        self.isOpen = not self.isOpen
        self.mainPanel.Visible = self.isOpen
    end)

    self:EnableDrag(header, self.mainPanel)
    self:EnableDrag(float, float) -- Кнопку тоже можно двигать!
    
    self.tabs = {}
    return self
end

-- Система вкладок (AddTab)
function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 40)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = name
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.Parent = self.tabContainer

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 20)
    indicator.Position = UDim2.new(0, 0, 0.5, -10)
    indicator.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    indicator.Visible = false
    indicator.Parent = tabBtn

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 2
    scroll.Visible = false
    scroll.Parent = self.contentArea
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0, 8)
    Instance.new("UIPadding", scroll).PaddingTop = UDim.new(0, 10)

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(self.tabs) do
            t.scroll.Visible = false
            t.btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            t.ind.Visible = false
        end
        scroll.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        indicator.Visible = true
    end)

    local tabData = {scroll = scroll, btn = tabBtn, ind = indicator}
    table.insert(self.tabs, tabData)
    if #self.tabs == 1 then scroll.Visible = true; tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255); indicator.Visible = true end

    local Elements = {}

    function Elements:AddButton(text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.9, 0, 0, 35)
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        btn.Text = text
        btn.Font = Enum.Font.GothamSemibold
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 14
        btn.Parent = scroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
    end

    function Elements:AddToggle(text, callback)
        local state = false
        local tFrame = Instance.new("Frame")
        tFrame.Size = UDim2.new(0.9, 0, 0, 40)
        tFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        tFrame.Parent = scroll
        Instance.new("UICorner", tFrame).CornerRadius = UDim.new(0, 8)

        local tLabel = Instance.new("TextLabel", tFrame)
        tLabel.Size = UDim2.new(1, -60, 1, 0)
        tLabel.Position = UDim2.new(0, 12, 0, 0)
        tLabel.BackgroundTransparency = 1
        tLabel.Text = text
        tLabel.Font = Enum.Font.GothamSemibold
        tLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        tLabel.TextXAlignment = Enum.TextXAlignment.Left

        local sw = Instance.new("TextButton", tFrame)
        sw.Size = UDim2.new(0, 40, 0, 20)
        sw.Position = UDim2.new(1, -50, 0.5, -10)
        sw.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        sw.Text = ""
        Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

        local circ = Instance.new("Frame", sw)
        circ.Size = UDim2.new(0, 16, 0, 16)
        circ.Position = UDim2.new(0, 2, 0.5, -8)
        circ.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", circ).CornerRadius = UDim.new(1, 0)

        sw.MouseButton1Click:Connect(function()
            state = not state
            QuickTween(circ, {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
            QuickTween(sw, {BackgroundColor3 = state and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(50, 50, 55)})
            callback(state)
        end)
    end

    function Elements:AddSlider(text, min, max, def, callback)
        local sFrame = Instance.new("Frame")
        sFrame.Size = UDim2.new(0.9, 0, 0, 50)
        sFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        sFrame.Parent = scroll
        Instance.new("UICorner", sFrame).CornerRadius = UDim.new(0, 8)

        local sLabel = Instance.new("TextLabel", sFrame)
        sLabel.Size = UDim2.new(1, -20, 0, 20)
        sLabel.Position = UDim2.new(0, 12, 0, 5)
        sLabel.BackgroundTransparency = 1
        sLabel.Text = text .. ": " .. def
        sLabel.Font = Enum.Font.GothamSemibold
        sLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        sLabel.TextXAlignment = Enum.TextXAlignment.Left

        local bar = Instance.new("Frame", sFrame)
        bar.Size = UDim2.new(1, -30, 0, 4)
        bar.Position = UDim2.new(0, 15, 0, 35)
        bar.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", bar)
        fill.Size = UDim2.new((def-min)/(max-min), 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local drag = false
        local function upd()
            local perc = math.clamp((UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * perc)
            fill.Size = UDim2.new(perc, 0, 1, 0)
            sLabel.Text = text .. ": " .. val
            callback(val)
        end
        bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; upd() end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
        UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then upd() end end)
    end

    return Elements
end

function CryoLib:EnableDrag(trigger, frame)
    local dragStart, startPos, dragging
    trigger.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

return CryoLib
