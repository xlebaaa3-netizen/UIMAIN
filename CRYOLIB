                currentColor = Color3.fromRGB(r, g, b); prev.BackgroundColor3 = currentColor; hexLabel.Text = string.format("#%02X%02X%02X", r, g, b); callback(currentColor)
            end
            
            local function createSlider(y, label, color, value, onChange)
                local track = Instance.new("Frame", sliderContainer); track.Size = UDim2.new(1, -60, 0, 8); track.Position = UDim2.new(0, 50, 0, y); track.BackgroundColor3 = Color3.fromRGB(45, 45, 60); track.BorderSizePixel = 0; track.ZIndex = 13
                Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
                local fill = Instance.new("Frame", track); fill.Size = UDim2.new(value/255, 0, 1, 0); fill.BackgroundColor3 = color; fill.BorderSizePixel = 0; fill.ZIndex = 14
                Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
                local handle = Instance.new("Frame", track); handle.Size = UDim2.new(0, 14, 0, 14); handle.Position = UDim2.new(value/255, -7, 0.5, -7); handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255); handle.BorderSizePixel = 0; handle.ZIndex = 15
                Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)
                local lbl = Instance.new("TextLabel", sliderContainer); lbl.Size = UDim2.new(0, 40, 0, 16); lbl.Position = UDim2.new(0, 0, 0, y - 4); lbl.BackgroundTransparency = 1; lbl.Text = label; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 10; lbl.TextColor3 = color; lbl.ZIndex = 13
                local valLbl = Instance.new("TextLabel", sliderContainer); valLbl.Size = UDim2.new(0, 30, 0, 16); valLbl.Position = UDim2.new(1, -30, 0, y - 4); valLbl.BackgroundTransparency = 1; valLbl.Text = tostring(value); valLbl.Font = Enum.Font.GothamBold; valLbl.TextSize = 10; valLbl.TextColor3 = Color3.fromRGB(180, 180, 180); valLbl.ZIndex = 13
                local dragging = false
                local function update()
                    local m = math.clamp((UserInputService:GetMouseLocation().X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local val = math.floor(m * 255)
                    fill.Size = UDim2.new(m, 0, 1, 0); handle.Position = UDim2.new(m, -7, 0.5, -7); valLbl.Text = tostring(val)
