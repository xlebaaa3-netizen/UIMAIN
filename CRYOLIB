-- ==================== FIX 2: FLOAT BUTTON ====================
function CryoLib:CreateFloatingButton()
	self.floatingBtn = Instance.new("ImageButton")
	self.floatingBtn.Name = "CryoLibFloat"
	self.floatingBtn.Size = UDim2.new(0, 55, 0, 55)
	self.floatingBtn.Position = UDim2.new(0, 20, 0.5, -27)
	self.floatingBtn.BackgroundTransparency = 1
	self.floatingBtn.Image = "rbxassetid://9751678226"
	self.floatingBtn.Parent = self.gui

	local isDragging = false
	local dragStart = nil
	local startPos = nil
	local moved = false

	self.floatingBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			moved = false
			dragStart = input.Position
			startPos = self.floatingBtn.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart

			if delta.Magnitude > 6 then
				moved = true
			end

			self.floatingBtn.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false

			if not moved then
				self:Toggle()
			end
		end
	end)
end

-- ==================== FIX 3: TAB AUTO ACTIVATE ====================
function CryoLib:FixTab(tabData)
	task.defer(function()
		if not self.currentTab then
			self.currentTab = tabData
			self:ActivateTab(tabData)
		end
	end)
end

