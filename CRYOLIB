function CryoLib:CreateFloatingButton()
    self.floatingBtn = Instance.new("ImageButton")
    self.floatingBtn.Name = "CryoLibFloat"
    self.floatingBtn.Size = UDim2.new(0, 55, 0, 55)
    self.floatingBtn.Position = UDim2.new(0, 20, 0.5, -27)
    self.floatingBtn.BackgroundTransparency = 1
    self.floatingBtn.Image = "rbxassetid://9751678226"
    self.floatingBtn.ImageColor3 = Color3.fromRGB(255, 255, 255)
    self.floatingBtn.ScaleType = Enum.ScaleType.Fit
    self.floatingBtn.Active = true
    self.floatingBtn.Draggable = true
    self.floatingBtn.Parent = self.gui
    
    local floatCorner = Instance.new("UICorner")
    floatCorner.CornerRadius = UDim.new(1, 0)
    floatCorner.Parent = self.floatingBtn
    
    local floatStroke = Instance.new("UIStroke")
    floatStroke.Color = Color3.fromRGB(100, 150, 255)
    floatStroke.Thickness = 2
    floatStroke.Parent = self.floatingBtn
    
    self.isOpen = false
    
    self.floatingBtn.MouseButton1Click:Connect(function()
        self:Toggle()
    end)
    
    if not self.isMobile then
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not gameProcessed and input.KeyCode == Enum.KeyCode.K then
                self:Toggle()
            end
        end)
    end
end

function CryoLib:Toggle()
    self.isOpen = not self.isOpen
    if self.isOpen then
        self.mainPanel.Visible = true
        self.mainPanel.Size = UDim2.new(0, 0, 0, 0)
        self.mainPanel.Position = UDim2.new(0.5, 0, 0.5, 0)
        TweenService:Create(self.mainPanel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 420, 0, 520),
            Position = UDim2.new(0.5, -210, 0.5, -260)
        }):Play()
    else
        TweenService:Create(self.mainPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        task.wait(0.3)
        self.mainPanel.Visible = false
        self.mainPanel.Size = UDim2.new(0, 420, 0, 520)
        self.mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    end
end

return function(title)
    local hub = CryoLib:new(title or "Cryo Hub")
    local api = {
        AddTab = function(name)
            return hub:AddTab(name)
        end,
        Toggle = function()
            hub:Toggle()
        end
    }
    return api
end
