-- ==================== CRYO PREMIUM UI V3.0 (DRAGGABLE & INTERACTIVE) ====================
local CryoLib = {}
CryoLib.__index = CryoLib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Player = game:GetService("Players").LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- Утилита для анимации цвета текста
local function HoverEffect(obj, targetCol)
    local originalCol = obj.TextColor3
    obj.MouseEnter:Connect(function()
        TweenService:Create(obj, TweenInfo.new(0.3), {TextColor3 = targetCol}):Play()
    end)
    obj.MouseLeave:Connect(function()
        TweenService:Create(obj, TweenInfo.new(0.3), {TextColor3 = originalCol}):Play()
    end)
end

function CryoLib:CreateWindow(title)
    local self = setmetatable({}, CryoLib)
    self.isOpen = false
    self.tabs = {}
    self.originalSize = UDim2.new(0, 500, 0, 400)

    self.gui = Instance.new("ScreenGui", PlayerGui)
    self.gui.Name = "Cryo_V3_Final"
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

    -- Main Panel
    self.mainPanel = Instance.new("Frame", self.gui)
    self.mainPanel.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    self.mainPanel.Position = UDim2.new(0.5, -250, 0.5, -200)
    self.mainPanel.Size = UDim2.new(0, 0, 0, 0)
    self.mainPanel.ClipsDescendants = true
    self.mainPanel.Visible = false
    Instance.new("UICorner", self.mainPanel).CornerRadius = UDim.new(0, 14)
    Instance.new("UIStroke", self.mainPanel).Color = Color3.fromRGB(45, 45, 50)

    -- Sidebar
    self.sidebar = Instance.new("Frame", self.mainPanel)
    self.sidebar.Size = UDim2.new(0, 150, 1, 0)
    self.sidebar.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    Instance.new("UICorner", self.sidebar).CornerRadius = UDim.new(0, 14)

    -- Title with Image
    local titleIcon = Instance.new("ImageLabel", self.sidebar)
    titleIcon.Size = UDim2.new(0, 24, 0, 24)
    titleIcon.Position = UDim2.new(0, 12, 0, 15)
    titleIcon.BackgroundTransparency = 1
    titleIcon.Image = "rbxassetid://75309286909772"

    local titleL = Instance.new("TextLabel", self.sidebar)
    titleL.Size = UDim2.new(1, -45, 0, 54)
    titleL.Position = UDim2.new(0, 42, 0, 0)
    titleL.Text = title:upper(); titleL.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleL.Font = Enum.Font.GothamBold; titleL.TextSize = 13; titleL.BackgroundTransparency = 1; titleL.TextXAlignment = 0

    -- Close Button (Крестик)
    local closeBtn = Instance.new("TextButton", self.mainPanel)
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 10)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"; closeBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    closeBtn.TextSize = 26; closeBtn.Font = Enum.Font.GothamMedium
    closeBtn.ZIndex = 5
    
    closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = Color3.fromRGB(255, 100, 100) end)
    closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = Color3.fromRGB(150, 150, 150) end)
    closeBtn.MouseButton1Click:Connect(function() self.gui:Destroy() end)

    self.tabContainer = Instance.new("Frame", self.sidebar)
    self.tabContainer.Size = UDim2.new(1, -20, 1, -70); self.tabContainer.Position = UDim2.new(0, 10, 0, 60)
    self.tabContainer.BackgroundTransparency = 1
    Instance.new("UIListLayout", self.tabContainer).Padding = UDim.new(0, 5)

    -- Scroll Area
    self.scrollFrame = Instance.new("ScrollingFrame", self.mainPanel)
    self.scrollFrame.Size = UDim2.new(1, -170, 1, -30); self.scrollFrame.Position = UDim2.new(0, 160, 0, 15)
    self.scrollFrame.BackgroundTransparency = 1; self.scrollFrame.ScrollBarThickness = 0
    local layout = Instance.new("UIListLayout", self.scrollFrame)
    layout.Padding = UDim.new(0, 8); layout.SortOrder = 2
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        self.scrollFrame.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 20)
    end)

    self:Internal_SetupDragging(self.sidebar)
    self:Internal_CreateFloatingButton()
    return self
end

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton", self.tabContainer)
    tabBtn.Size = UDim2.new(1, 0, 0, 35)
    tabBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    tabBtn.Text = name; tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.Font = Enum.Font.GothamMedium; tabBtn.TextSize = 12
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 8)
    
    HoverEffect(tabBtn, Color3.fromRGB(100, 150, 255))

    local tabData = { btn = tabBtn, elements = {} }
    table.insert(self.tabs, tabData)

    tabBtn.MouseButton1Click:Connect(function() self:ActivateTab(tabData) end)
    
    local tabInterface = { Lib = self, tabData = tabData }

    function tabInterface:AddSection(sName)
        local sect = { Lib = self.Lib, tabData = self.tabData }
        
        local function reg(el)
            el.Visible = false; el.Parent = sect.Lib.scrollFrame
            table.insert(sect.tabData.elements, el); return el
        end

        function sect:AddButton(text, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -10, 0, 38); b.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
            b.Text = text; b.TextColor3 = Color3.fromRGB(180, 180, 180)
            b.Font = Enum.Font.GothamMedium; b.TextSize = 13
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
            HoverEffect(b, Color3.fromRGB(100, 150, 255))
            b.MouseButton1Click:Connect(cb)
            return reg(b)
        end

        function sect:AddToggle(text, cb)
            local state = false
            local tFrame = Instance.new("Frame")
            tFrame.Size = UDim2.new(1, -10, 0, 42); tFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 33)
            Instance.new("UICorner", tFrame).CornerRadius = UDim.new(0, 8)
            
            local label = Instance.new("TextLabel", tFrame)
            label.Size = UDim2.new(1, -60, 1, 0); label.Position = UDim2.new(0, 15, 0, 0)
            label.BackgroundTransparency = 1; label.Text = text; label.TextColor3 = Color3.fromRGB(180, 180, 180)
            label.Font = Enum.Font.GothamMedium; label.TextSize = 13; label.TextXAlignment = 0
            HoverEffect(label, Color3.fromRGB(100, 150, 255))

            local switch = Instance.new("Frame", tFrame)
            switch.Size = UDim2.new(0, 36, 0, 20); switch.Position = UDim2.new(1, -50, 0.5, -10)
            switch.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

            local circle = Instance.new("Frame", switch)
            circle.Size = UDim2.new(0, 14, 0, 14); circle.Position = UDim2.new(0, 3, 0.5, -7)
            circle.BackgroundColor3 = Color3.new(1, 1, 1)
            Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

            local btn = Instance.new("TextButton", tFrame)
            btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""

            btn.MouseButton1Click:Connect(function()
                state = not state
                local targetX = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                local targetCol = state and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(45, 45, 50)
                TweenService:Create(circle, TweenInfo.new(0.2), {Position = targetX}):Play()
                TweenService:Create(switch, TweenInfo.new(0.2), {BackgroundColor3 = targetCol}):Play()
                cb(state)
            end)
            return reg(tFrame)
        end

        return sect
    end
    return tabInterface
end

function CryoLib:ActivateTab(tabData)
    for _, t in ipairs(self.tabs) do
        TweenService:Create(t.btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(22, 22, 26), TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
        for _, el in ipairs(t.elements) do el.Visible = false end
    end
    TweenService:Create(tabData.btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(35, 35, 45), TextColor3 = Color3.fromRGB(100, 150, 255)}):Play()
    for _, el in ipairs(tabData.elements) do el.Visible = true end
end

function CryoLib:Toggle()
    self.isOpen = not self.isOpen
    self.mainPanel.Visible = true
    local targetSize = self.isOpen and self.originalSize or UDim2.new(0,0,0,0)
    local targetPos = self.isOpen and UDim2.new(0.5, -250, 0.5, -200) or UDim2.new(0.5, 0, 0.5, 0)
    TweenService:Create(self.mainPanel, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = targetSize, Position = targetPos}):Play()
end

-- Система перетаскивания (универсальная)
function CryoLib:Internal_SetupDragging(obj)
    local dragging, dragInput, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = obj.Parent == self.gui and obj.Position or self.mainPanel.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local target = obj.Parent == self.gui and obj or self.mainPanel
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function CryoLib:Internal_CreateFloatingButton()
    local fb = Instance.new("ImageButton", self.gui)
    fb.Size = UDim2.new(0, 55, 0, 55); fb.Position = UDim2.new(0, 20, 0.5, -27)
    fb.BackgroundColor3 = Color3.fromRGB(20, 20, 25); fb.Image = "rbxassetid://9751678226"
    fb.ZIndex = 100; fb.ClipsDescendants = true
    Instance.new("UICorner", fb).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", fb).Color = Color3.fromRGB(100, 150, 255)
    
    fb.MouseButton1Click:Connect(function() self:Toggle() end)
    self:Internal_SetupDragging(fb) -- Делаем кнопку перетаскиваемой!
end

return CryoLib
