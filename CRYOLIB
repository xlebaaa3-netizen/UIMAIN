local CryoLib = {}
CryoLib.__index = CryoLib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- Палитра строго по твоему исходнику game.lua
local Theme = {
    Background = Color3.fromRGB(15, 15, 15),
    Element = Color3.fromRGB(22, 22, 22),
    Accent = Color3.fromRGB(110, 150, 255),
    Outline = Color3.fromRGB(35, 35, 35),
    Text = Color3.fromRGB(240, 240, 240),
    Disabled = Color3.fromRGB(150, 150, 150)
}

function CryoLib:CreateWindow(titleText)
    local self = setmetatable({}, CryoLib)
    
    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "CryoVenyx"
    self.gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    self.gui.ResetOnSpawn = false

    -- Main Panel
    self.main = Instance.new("Frame")
    self.main.Size = UDim2.new(0, 430, 0, 530)
    self.main.Position = UDim2.new(0.5, -215, 0.5, -265)
    self.main.BackgroundColor3 = Theme.Background
    self.main.BorderSizePixel = 0
    self.main.Parent = self.gui

    Instance.new("UICorner", self.main).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", self.main)
    stroke.Color = Theme.Outline
    stroke.Thickness = 1.2

    -- Header (TopBar)
    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 45)
    header.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    header.BorderSizePixel = 0
    header.Parent = self.main
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 8)

    -- Логотип
    local logo = Instance.new("ImageLabel")
    logo.Size = UDim2.new(0, 30, 0, 30)
    logo.Position = UDim2.new(0, 12, 0.5, -15)
    logo.BackgroundTransparency = 1
    logo.Image = "rbxassetid://75309286909772"
    logo.Parent = header

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -60, 1, 0)
    title.Position = UDim2.new(0, 52, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.Font = Enum.Font.GothamBold
    title.TextColor3 = Theme.Text
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    -- Sidebar (Tabs Container)
    self.sidebar = Instance.new("Frame")
    self.sidebar.Size = UDim2.new(0, 120, 1, -45)
    self.sidebar.Position = UDim2.new(0, 0, 0, 45)
    self.sidebar.BackgroundTransparency = 1
    self.sidebar.Parent = self.main
    Instance.new("UIListLayout", self.sidebar).Padding = UDim.new(0, 2)

    self.container = Instance.new("Frame")
    self.container.Size = UDim2.new(1, -135, 1, -55)
    self.container.Position = UDim2.new(0, 125, 0, 50)
    self.container.BackgroundTransparency = 1
    self.container.Parent = self.main

    -- Плавающая кнопка
    local float = Instance.new("ImageButton")
    float.Size = UDim2.new(0, 55, 0, 55)
    float.Position = UDim2.new(0, 30, 0.5, -27)
    float.BackgroundColor3 = Theme.Background
    float.Image = "rbxassetid://75309286909772"
    float.Parent = self.gui
    Instance.new("UICorner", float).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", float).Color = Theme.Accent
    
    float.MouseButton1Click:Connect(function()
        self.main.Visible = not self.main.Visible
    end)

    self:MakeDraggable(header, self.main)
    self:MakeDraggable(float, float)
    
    self.tabs = {}
    return self
end

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 35)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = name
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextColor3 = Theme.Disabled
    tabBtn.TextSize = 13
    tabBtn.Parent = self.sidebar

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 0
    scroll.Visible = false
    scroll.Parent = self.container
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0, 6)

    tabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(self.tabs) do
            v.s.Visible = false
            v.b.TextColor3 = Theme.Disabled
        end
        scroll.Visible = true
        tabBtn.TextColor3 = Theme.Text
    end)

    table.insert(self.tabs, {s = scroll, b = tabBtn})
    if #self.tabs == 1 then scroll.Visible = true; tabBtn.TextColor3 = Theme.Text end

    local Elements = {}

    function Elements:AddButton(text, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 35)
        btn.BackgroundColor3 = Theme.Element
        btn.Text = text
        btn.Font = Enum.Font.GothamBold
        btn.TextColor3 = Theme.Text
        btn.TextSize = 13
        btn.Parent = scroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        Instance.new("UIStroke", btn).Color = Theme.Outline
        btn.MouseButton1Click:Connect(callback)
    end

    function Elements:AddToggle(text, callback)
        local state = false
        local tFrame = Instance.new("TextButton")
        tFrame.Size = UDim2.new(1, 0, 0, 35)
        tFrame.BackgroundColor3 = Theme.Element
        tFrame.Text = ""
        tFrame.Parent = scroll
        Instance.new("UICorner", tFrame).CornerRadius = UDim.new(0, 6)
        Instance.new("UIStroke", tFrame).Color = Theme.Outline

        local label = Instance.new("TextLabel", tFrame)
        label.Size = UDim2.new(1, -50, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left

        local box = Instance.new("Frame", tFrame)
        box.Size = UDim2.new(0, 18, 0, 18)
        box.Position = UDim2.new(1, -30, 0.5, -9)
        box.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

        tFrame.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(box, TweenInfo.new(0.2), {BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(40, 40, 40)}):Play()
            callback(state)
        end)
    end

    return Elements
end

function CryoLib:MakeDraggable(obj, frame)
    local dragging, dragInput, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

return CryoLib
