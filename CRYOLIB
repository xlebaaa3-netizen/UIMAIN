-- ==================== CRYO LIBRARY (STABLE VERSION 2.0) ====================
local CryoLib = {}
CryoLib.__index = CryoLib

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function SafeCall(callback, ...)
    if type(callback) == "function" then
        local success, err = pcall(callback, ...)
        if not success then warn("[CryoLib] Callback error: " .. tostring(err)) end
    end
end

local function SafeTween(instance, tweenInfo, properties)
    if not instance or not instance.Parent then return nil end
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

-- ==================== ОСНОВНЫЕ ФУНКЦИИ ====================

function CryoLib:CreateWindow(title)
    local existing = PlayerGui:FindFirstChild("CryoLibGUI")
    if existing then existing:Destroy() end

    local self = setmetatable({}, CryoLib)
    self._destroyed = false
    self.isOpen = false
    self.minimized = false
    self.connections = {} -- Для предотвращения утечек памяти
    self.tabs = {}
    
    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "CryoLibGUI"
    self.gui.ResetOnSpawn = false
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    self.gui.Parent = PlayerGui

    self:CreateMainPanel(title)
    self:CreateFloatingButton()
    self:SetupHotkey()

    return self
end

function CryoLib:CreateMainPanel(title)
    self.originalSize = UDim2.new(0, 420, 0, 520)
    
    self.mainPanel = Instance.new("Frame")
    self.mainPanel.Name = "MainPanel"
    self.mainPanel.Size = self.originalSize
    self.mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    self.mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    self.mainPanel.BorderSizePixel = 0
    self.mainPanel.Active = true
    self.mainPanel.Visible = false
    self.mainPanel.ClipsDescendants = true
    self.mainPanel.Parent = self.gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = self.mainPanel

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 80)
    stroke.Thickness = 1.5
    stroke.Parent = self.mainPanel

    self:CreateHeader(title)
    self:CreateTabContainer()
    self:CreateContentArea()
    self:SetupDragging()
end

-- [Упрощено для краткости, логика хедера и вкладок аналогична твоей, но с правками связей]
function CryoLib:CreateHeader(title)
    self.header = Instance.new("Frame")
    self.header.Size = UDim2.new(1, 0, 0, 50)
    self.header.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    self.header.Parent = self.mainPanel

    local headerTitle = Instance.new("TextLabel")
    headerTitle.Size = UDim2.new(0, 200, 0, 30)
    headerTitle.Position = UDim2.new(0, 20, 0, 10)
    headerTitle.BackgroundTransparency = 1
    headerTitle.Text = title or "Cryo Hub"
    headerTitle.Font = Enum.Font.GothamBlack
    headerTitle.TextSize = 20
    headerTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    headerTitle.TextXAlignment = Enum.TextXAlignment.Left
    headerTitle.Parent = self.header

    -- Кнопка закрытия
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -40, 0, 10)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"
    closeBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeBtn.TextSize = 25
    closeBtn.Parent = self.header
    closeBtn.MouseButton1Click:Connect(function() self:Destroy() end)
end

function CryoLib:CreateContentArea()
    self.scrollFrame = Instance.new("ScrollingFrame")
    self.scrollFrame.Size = UDim2.new(1, -120, 1, -70)
    self.scrollFrame.Position = UDim2.new(0, 110, 0, 60)
    self.scrollFrame.BackgroundTransparency = 1
    self.scrollFrame.ScrollBarThickness = 2
    self.scrollFrame.Parent = self.mainPanel

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.Parent = self.scrollFrame

    -- Оптимизированное обновление размера
    table.insert(self.connections, layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        self.scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end))
end

-- ==================== СИСТЕМА ПЕРЕТАСКИВАНИЯ (FIXED) ====================
function CryoLib:SetupDragging()
    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        self.mainPanel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    table.insert(self.connections, self.header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.mainPanel.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))

    table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end))
end

-- ==================== УПРАВЛЕНИЕ ЖИЗНЕННЫМ ЦИКЛОМ ====================
function CryoLib:Toggle()
    if self._destroyed then return end
    self.isOpen = not self.isOpen
    
    if self.isOpen then
        self.mainPanel.Visible = true
        SafeTween(self.mainPanel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = self.originalSize,
            ImageTransparency = 0
        })
    else
        local tween = SafeTween(self.mainPanel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        })
        if tween then
            tween.Completed:Connect(function() 
                if not self.isOpen then self.mainPanel.Visible = false end 
            end)
        end
    end
end

function CryoLib:SetupHotkey()
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.K then
            self:Toggle()
        end
    end))
end

function CryoLib:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    
    -- Отключаем все события (ВАЖНО!)
    for _, connection in ipairs(self.connections) do
        if connection then connection:Disconnect() end
    end
    
    if self.gui then self.gui:Destroy() end
end

-- Пример метода уведомления (Дописано)
function CryoLib:Notify(title, text, duration)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 250, 0, 60)
    frame.Position = UDim2.new(1, 10, 1, -70)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    frame.Parent = self.gui
    
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", frame)
    s.Color = Color3.fromRGB(100, 150, 255)
    
    local l = Instance.new("TextLabel", frame)
    l.Size = UDim2.new(1, -20, 1, 0)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.Text = title .. "\n" .. text
    l.TextColor3 = Color3.fromRGB(255, 255, 255)
    l.BackgroundTransparency = 1
    l.TextWrapped = true

    SafeTween(frame, TweenInfo.new(0.5), {Position = UDim2.new(1, -260, 1, -70)})
    
    task.delay(duration or 3, function()
        local t = SafeTween(frame, TweenInfo.new(0.5), {Position = UDim2.new(1, 10, 1, -70)})
        if t then t.Completed:Connect(function() frame:Destroy() end) end
    end)
end

return CryoLib
