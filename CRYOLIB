-- ==================== CRYO LIBRARY V2.1 (FIXED) ====================
local CryoLib = {}
CryoLib.__index = CryoLib

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function SafeCall(callback, ...)
    if type(callback) == "function" then
        local success, err = pcall(callback, ...)
        if not success then warn("[CryoLib] Callback error: " .. tostring(err)) end
    end
end

-- ==================== ОСНОВНОЙ КЛАСС ====================

function CryoLib:CreateWindow(title)
    local self = setmetatable({}, CryoLib)
    self.isOpen = false
    self.tabs = {}
    self.connections = {}
    self.originalSize = UDim2.new(0, 420, 0, 520)

    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "CryoLibGUI"
    self.gui.ResetOnSpawn = false
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    self.gui.Parent = PlayerGui

    self.mainPanel = Instance.new("Frame")
    self.mainPanel.Size = UDim2.new(0, 0, 0, 0)
    self.mainPanel.Position = UDim2.new(0.5, 0, 0.5, 0)
    self.mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    self.mainPanel.ClipsDescendants = true
    self.mainPanel.Visible = false
    self.mainPanel.Parent = self.gui
    Instance.new("UICorner", self.mainPanel).CornerRadius = UDim.new(0, 12)

    self:Internal_CreateHeader(title)
    self:Internal_CreateTabContainer()
    self:Internal_CreateContentArea()
    self:Internal_SetupDragging()
    self:Internal_CreateFloatingButton()
    
    table.insert(self.connections, UserInputService.InputBegan:Connect(function(i, g)
        if not g and i.KeyCode == Enum.KeyCode.K then self:Toggle() end
    end))

    return self
end

function CryoLib:Internal_CreateHeader(title)
    self.header = Instance.new("Frame")
    self.header.Size = UDim2.new(1, 0, 0, 50)
    self.header.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    self.header.Parent = self.mainPanel
    Instance.new("UICorner", self.header)

    local l = Instance.new("TextLabel", self.header)
    l.Size = UDim2.new(1, -50, 1, 0); l.Position = UDim2.new(0, 20, 0, 0)
    l.Text = title or "Cryo Hub"; l.TextColor3 = Color3.new(1,1,1)
    l.Font = Enum.Font.GothamBlack; l.TextSize = 18; l.BackgroundTransparency = 1; l.TextXAlignment = 0
end

function CryoLib:Internal_CreateTabContainer()
    self.tabContainer = Instance.new("Frame", self.mainPanel)
    self.tabContainer.Size = UDim2.new(0, 100, 1, -50); self.tabContainer.Position = UDim2.new(0,0,0,50)
    self.tabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    local layout = Instance.new("UIListLayout", self.tabContainer)
    layout.HorizontalAlignment = 1; layout.Padding = UDim.new(0,5)
end

function CryoLib:Internal_CreateContentArea()
    self.scrollFrame = Instance.new("ScrollingFrame", self.mainPanel)
    self.scrollFrame.Size = UDim2.new(1, -110, 1, -60); self.scrollFrame.Position = UDim2.new(0, 105, 0, 55)
    self.scrollFrame.BackgroundTransparency = 1; self.scrollFrame.ScrollBarThickness = 2
    local layout = Instance.new("UIListLayout", self.scrollFrame)
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = 2
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        self.scrollFrame.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 20)
    end)
end

-- ==================== СИСТЕМА ВКЛАДОК И ЭЛЕМЕНТОВ ====================

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton", self.tabContainer)
    tabBtn.Size = UDim2.new(0, 90, 0, 35); tabBtn.Text = name
    tabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35); tabBtn.TextColor3 = Color3.new(0.6, 0.6, 0.6)
    Instance.new("UICorner", tabBtn)

    local tabData = { btn = tabBtn, elements = {} }
    table.insert(self.tabs, tabData)

    tabBtn.MouseButton1Click:Connect(function() self:ActivateTab(tabData) end)
    if #self.tabs == 1 then task.defer(function() self:ActivateTab(tabData) end) end

    local tabInterface = { Library = self, tabData = tabData }

    function tabInterface:AddSection(sName)
        local sectInterface = { Library = self.Library, tabData = self.tabData }
        
        -- Вспомогательная функция для регистрации элементов
        local function reg(el)
            el.Visible = false
            el.Parent = sectInterface.Library.scrollFrame
            table.insert(sectInterface.tabData.elements, el)
            return el
        end

        -- МЕТОД ADDLABEL (ИСПРАВЛЕНО)
        function sectInterface:AddLabel(text)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(1, -10, 0, 25)
            l.BackgroundTransparency = 1
            l.Text = text
            l.TextColor3 = Color3.fromRGB(200, 200, 200)
            l.Font = Enum.Font.Gotham
            l.TextSize = 14
            return reg(l)
        end

        function sectInterface:AddButton(text, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -10, 0, 35)
            b.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            b.Text = text; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.Gotham
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function() SafeCall(cb) end)
            return reg(b)
        end

        function sectInterface:AddToggle(text, cb)
            local s = false
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -10, 0, 35)
            b.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            b.Text = text .. ": OFF"; b.TextColor3 = Color3.fromRGB(200, 80, 80)
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function()
                s = not s
                b.Text = text .. (s and ": ON" or ": OFF")
                b.TextColor3 = s and Color3.fromRGB(80, 200, 80) or Color3.fromRGB(200, 80, 80)
                SafeCall(cb, s)
            end)
            return reg(b)
        end

        return sectInterface
    end
    return tabInterface
end

-- ==================== ПРОЧЕЕ ====================

function CryoLib:ActivateTab(tabData)
    for _, t in ipairs(self.tabs) do
        t.btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        for _, el in ipairs(t.elements) do el.Visible = false end
    end
    tabData.btn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    for _, el in ipairs(tabData.elements) do el.Visible = true end
end

function CryoLib:Toggle()
    self.isOpen = not self.isOpen
    self.mainPanel.Visible = true
    local targetSize = self.isOpen and self.originalSize or UDim2.new(0,0,0,0)
    local targetPos = self.isOpen and UDim2.new(0.5, -210, 0.5, -260) or UDim2.new(0.5, 0, 0.5, 0)
    
    TweenService:Create(self.mainPanel, TweenInfo.new(0.3), {Size = targetSize, Position = targetPos}):Play()
end

function CryoLib:Internal_SetupDragging()
    local drag, start, startPos
    self.header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; start = i.Position; startPos = self.mainPanel.Position
            i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - start
            self.mainPanel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function CryoLib:Internal_CreateFloatingButton()
    local fb = Instance.new("TextButton", self.gui)
    fb.Size = UDim2.new(0, 50, 0, 50); fb.Position = UDim2.new(0, 20, 0.5, -25)
    fb.Text = "UI"; fb.ZIndex = 100; fb.BackgroundColor3 = Color3.fromRGB(20, 20, 25); fb.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", fb).CornerRadius = UDim.new(1, 0)
    fb.MouseButton1Click:Connect(function() self:Toggle() end)
end

function CryoLib:Notify(t, m, d)
    print("[" .. t .. "]: " .. m) -- Упрощенный нотифай для стабильности
end

function CryoLib:Destroy()
    self.gui:Destroy()
end

return CryoLib
