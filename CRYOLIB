function CryoLib:SetupDragging()
    local isDragging = false
    local dragStartMouse = nil
    local dragStartFramePos = nil
    
    self.header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
            dragStartFramePos = self.mainPanel.AbsolutePosition
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not isDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartMouse
        local newPos = dragStartFramePos + delta
        self.mainPanel.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
            dragStartMouse = nil
            dragStartFramePos = nil
        end
    end)
end

function CryoLib:ToggleMinimize()
    self.minimized = not self.minimized
    if self.minimized then
        self.contentArea.Visible = false
        self.tabContainer.Visible = false
        TweenService:Create(self.mainPanel, TweenInfo.new(0.3), {Size = UDim2.new(0, 420, 0, 50)}):Play()
    else
        self.contentArea.Visible = true
        self.tabContainer.Visible = true
        TweenService:Create(self.mainPanel, TweenInfo.new(0.3), {Size = UDim2.new(0, 420, 0, 520)}):Play()
    end
end

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 40)
    tabBtn.Position = UDim2.new(0, 0, 0, #self.tabs * 42)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = name
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 13
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.Parent = self.tabContainer
    
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 20)
    indicator.Position = UDim2.new(0, 0, 0.5, -10)
    indicator.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.Parent = tabBtn
    
    local tabData = {btn = tabBtn, indicator = indicator, name = name, elements = {}}
    table.insert(self.tabs, tabData)
    
    tabBtn.MouseButton1Click:Connect(function()
        self:ActivateTab(tabData)
    end)
    
    if #self.tabs == 1 then
        self:ActivateTab(tabData)
    end
    
    -- Возвращаем таблицу с методами для добавления элементов
    return {
        AddButton = function(text, callback)
            return self:AddButtonToTab(tabData, text, callback)
        end,
        AddToggle = function(text, callback)
            return self:AddToggleToTab(tabData, text, callback)
        end,
        AddSlider = function(text, min, max, callback)
            return self:AddSliderToTab(tabData, text, min, max, callback)
        end,
        AddLabel = function(text)
            return self:AddLabelToTab(tabData, text)
        end
    }
end

function CryoLib:ActivateTab(tabData)
    for _, t in ipairs(self.tabs) do
        TweenService:Create(t.btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
        TweenService:Create(t.indicator, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        
        for _, element in ipairs(t.elements) do
            element.Visible = false
        end
    end
    
    self.currentTab = tabData
    TweenService:Create(tabData.btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    TweenService:Create(tabData.indicator, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    
    for _, element in ipairs(tabData.elements) do
        element.Visible = true
    end
end

