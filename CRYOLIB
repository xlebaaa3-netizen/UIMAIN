-- [[ CRYO UI - VENYX STYLE REPLICA ]]
local CryoLib = {}
CryoLib.__index = CryoLib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = game:GetService("Players").LocalPlayer

-- Цвета точь-в-точь как в твоем game.lua
local Theme = {
    Background = Color3.fromRGB(15, 15, 15),
    Secondary = Color3.fromRGB(20, 20, 20),
    Accent = Color3.fromRGB(110, 150, 255),
    Outline = Color3.fromRGB(30, 30, 30),
    Text = Color3.fromRGB(255, 255, 255),
    DisabledText = Color3.fromRGB(130, 130, 130)
}

function CryoLib:CreateWindow(titleText)
    local self = setmetatable({}, CryoLib)
    
    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "CryoVenyx"
    self.gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    self.gui.ResetOnSpawn = false

    -- Main
    self.main = Instance.new("Frame")
    self.main.Size = UDim2.new(0, 450, 0, 550)
    self.main.Position = UDim2.new(0.5, -225, 0.5, -275)
    self.main.BackgroundColor3 = Theme.Background
    self.main.BorderSizePixel = 0
    self.main.Parent = self.gui

    Instance.new("UICorner", self.main).CornerRadius = UDim.new(0, 4)
    local mainStroke = Instance.new("UIStroke", self.main)
    mainStroke.Color = Theme.Outline
    mainStroke.Thickness = 1

    -- Header (Top Bar)
    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 40)
    header.BackgroundColor3 = Theme.Secondary
    header.BorderSizePixel = 0
    header.Parent = self.main
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 4)

    -- Логотип слева
    local logo = Instance.new("ImageLabel")
    logo.Size = UDim2.new(0, 26, 0, 26)
    logo.Position = UDim2.new(0, 10, 0.5, -13)
    logo.BackgroundTransparency = 1
    logo.Image = "rbxassetid://75309286909772"
    logo.Parent = header

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -50, 1, 0)
    title.Position = UDim2.new(0, 42, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.Font = Enum.Font.GothamBold
    title.TextColor3 = Theme.Text
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    -- Контейнер для кнопок вкладок (Sidebar)
    self.sidebar = Instance.new("Frame")
    self.sidebar.Size = UDim2.new(0, 120, 1, -40)
    self.sidebar.Position = UDim2.new(0, 0, 0, 40)
    self.sidebar.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    self.sidebar.BorderSizePixel = 0
    self.sidebar.Parent = self.main
    
    local sideLayout = Instance.new("UIListLayout", self.sidebar)
    sideLayout.Padding = UDim.new(0, 2)
    sideLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    -- Основная зона контента
    self.container = Instance.new("Frame")
    self.container.Size = UDim2.new(1, -130, 1, -50)
    self.container.Position = UDim2.new(0, 125, 0, 45)
    self.container.BackgroundTransparency = 1
    self.container.Parent = self.main

    -- Та самая плавающая кнопка
    local float = Instance.new("ImageButton")
    float.Size = UDim2.new(0, 50, 0, 50)
    float.Position = UDim2.new(0, 20, 0.5, -25)
    float.BackgroundColor3 = Theme.Secondary
    float.Image = "rbxassetid://75309286909772"
    float.Parent = self.gui
    Instance.new("UICorner", float).CornerRadius = UDim.new(1, 0)
    local fStroke = Instance.new("UIStroke", float)
    fStroke.Color = Theme.Accent
    fStroke.Thickness = 2

    float.MouseButton1Click:Connect(function()
        self.main.Visible = not self.main.Visible
    end)

    self:MakeDraggable(header, self.main)
    self:MakeDraggable(float, float)
    
    self.tabs = {}
    return self
end

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0.9, 0, 0, 30)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = name
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextColor3 = Theme.DisabledText
    tabBtn.TextSize = 13
    tabBtn.Parent = self.sidebar

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 2
    scroll.Visible = false
    scroll.Parent = self.container
    Instance.new("UIListLayout", scroll).Padding = UDim.new(0, 5)

    tabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(self.tabs) do
            v.s.Visible = false
            v.b.TextColor3 = Theme.DisabledText
        end
        scroll.Visible = true
        tabBtn.TextColor3 = Theme.Text
    end)

    table.insert(self.tabs, {s = scroll, b = tabBtn})
    if #self.tabs == 1 then scroll.Visible = true; tabBtn.TextColor3 = Theme.Text end

    local Elements = {}

    -- Элемент: Кнопка (как в Venyx)
    function Elements:AddButton(text, callback)
        local bFrame = Instance.new("TextButton")
        bFrame.Size = UDim2.new(1, -5, 0, 32)
        bFrame.BackgroundColor3 = Theme.Secondary
        bFrame.Text = text
        bFrame.Font = Enum.Font.Gotham
        bFrame.TextColor3 = Theme.Text
        bFrame.TextSize = 13
        bFrame.Parent = scroll
        
        Instance.new("UICorner", bFrame).CornerRadius = UDim.new(0, 4)
        Instance.new("UIStroke", bFrame).Color = Theme.Outline

        bFrame.MouseButton1Click:Connect(callback)
    end

    -- Элемент: Тоггл (как в Venyx)
    function Elements:AddToggle(text, callback)
        local state = false
        local tFrame = Instance.new("TextButton")
        tFrame.Size = UDim2.new(1, -5, 0, 32)
        tFrame.BackgroundColor3 = Theme.Secondary
        tFrame.Text = ""
        tFrame.Parent = scroll
        Instance.new("UICorner", tFrame).CornerRadius = UDim.new(0, 4)
        Instance.new("UIStroke", tFrame).Color = Theme.Outline

        local label = Instance.new("TextLabel", tFrame)
        label.Size = UDim2.new(1, -40, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.Text = text
        label.Font = Enum.Font.Gotham
        label.TextColor3 = Theme.Text
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.BackgroundTransparency = 1

        local indicator = Instance.new("Frame", tFrame)
        indicator.Size = UDim2.new(0, 16, 0, 16)
        indicator.Position = UDim2.new(1, -26, 0.5, -8)
        indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        Instance.new("UICorner", indicator).CornerRadius = UDim.new(0, 4)
        
        tFrame.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(40, 40, 40)}):Play()
            callback(state)
        end)
    end

    return Elements
end

function CryoLib:MakeDraggable(obj, frame)
    local dragging, dragInput, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

return CryoLib
