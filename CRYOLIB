-- ==================== CRYO LIBRARY V2.2 (PREMIUM UI) ====================
local CryoLib = {}
CryoLib.__index = CryoLib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local function SafeTween(inst, info, prop)
    if inst then TweenService:Create(inst, info, prop):Play() end
end

function CryoLib:CreateWindow(title)
    local self = setmetatable({}, CryoLib)
    self.isOpen = false
    self.tabs = {}
    self.originalSize = UDim2.new(0, 450, 0, 550)

    self.gui = Instance.new("ScreenGui", PlayerGui)
    self.gui.Name = "CryoLib_Final"
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

    -- Main Panel
    self.mainPanel = Instance.new("Frame", self.gui)
    self.mainPanel.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    self.mainPanel.BorderSizePixel = 0
    self.mainPanel.Position = UDim2.new(0.5, 0, 0.5, 0)
    self.mainPanel.Size = UDim2.new(0, 0, 0, 0)
    self.mainPanel.ClipsDescendants = true
    self.mainPanel.Visible = false
    
    Instance.new("UICorner", self.mainPanel).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", self.mainPanel)
    stroke.Color = Color3.fromRGB(45, 45, 55)
    stroke.Thickness = 2

    -- Header
    self.header = Instance.new("Frame", self.mainPanel)
    self.header.Size = UDim2.new(1, 0, 0, 45)
    self.header.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    
    local titleL = Instance.new("TextLabel", self.header)
    titleL.Size = UDim2.new(1, -20, 1, 0)
    titleL.Position = UDim2.new(0, 15, 0, 0)
    titleL.Text = title:upper(); titleL.TextColor3 = Color3.new(1,1,1)
    titleL.Font = Enum.Font.GothamBold; titleL.TextSize = 16; titleL.BackgroundTransparency = 1; titleL.TextXAlignment = 0

    -- Containers
    self.tabContainer = Instance.new("Frame", self.mainPanel)
    self.tabContainer.Size = UDim2.new(0, 120, 1, -45); self.tabContainer.Position = UDim2.new(0, 0, 0, 45)
    self.tabContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    
    Instance.new("UIListLayout", self.tabContainer).Padding = UDim.new(0, 5)

    self.scrollFrame = Instance.new("ScrollingFrame", self.mainPanel)
    self.scrollFrame.Size = UDim2.new(1, -135, 1, -60); self.scrollFrame.Position = UDim2.new(0, 130, 0, 55)
    self.scrollFrame.BackgroundTransparency = 1; self.scrollFrame.ScrollBarThickness = 2

    local layout = Instance.new("UIListLayout", self.scrollFrame)
    layout.Padding = UDim.new(0, 8); layout.SortOrder = 2
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        self.scrollFrame.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 20)
    end)

    self:Internal_SetupDragging()
    self:Internal_CreateFloatingButton()
    return self
end

function CryoLib:AddTab(name)
    local tabBtn = Instance.new("TextButton", self.tabContainer)
    tabBtn.Size = UDim2.new(1, -10, 0, 35)
    tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    tabBtn.Text = name; tabBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
    tabBtn.Font = Enum.Font.GothamBold; tabBtn.TextSize = 13
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    local tabData = { btn = tabBtn, elements = {} }
    table.insert(self.tabs, tabData)

    tabBtn.MouseButton1Click:Connect(function() self:ActivateTab(tabData) end)
    if #self.tabs == 1 then task.defer(function() self:ActivateTab(tabData) end) end

    local tabInterface = { Lib = self, tabData = tabData }

    function tabInterface:AddSection(sName)
        local sect = { Lib = self.Lib, tabData = self.tabData }
        
        local function reg(el)
            el.Visible = false; el.Parent = sect.Lib.scrollFrame
            table.insert(sect.tabData.elements, el); return el
        end

        function sect:AddButton(text, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -5, 0, 38); b.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            b.Text = text; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.GothamMedium
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(cb)
            return reg(b)
        end

        function sect:AddToggle(text, cb)
            local s = false
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -5, 0, 38); b.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            b.Text = text .. ": OFF"; b.TextColor3 = Color3.fromRGB(220, 60, 60); b.Font = Enum.Font.GothamBold
            Instance.new("UICorner", b)
            b.MouseButton1Click:Connect(function()
                s = not s; b.Text = text .. (s and ": ON" or ": OFF")
                SafeTween(b, TweenInfo.new(0.3), {TextColor3 = s and Color3.fromRGB(60, 220, 60) or Color3.fromRGB(220, 60, 60)})
                cb(s)
            end)
            return reg(b)
        end

        function sect:AddSlider(text, min, max, cb)
            local sliderFrame = Instance.new("Frame")
            sliderFrame.Size = UDim2.new(1, -5, 0, 50); sliderFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
            Instance.new("UICorner", sliderFrame)
            
            local lab = Instance.new("TextLabel", sliderFrame)
            lab.Size = UDim2.new(1, 0, 0, 20); lab.Position = UDim2.new(0, 10, 0, 5)
            lab.Text = text .. ": " .. min; lab.TextColor3 = Color3.new(1,1,1); lab.BackgroundTransparency = 1; lab.TextXAlignment = 0

            local bar = Instance.new("Frame", sliderFrame)
            bar.Size = UDim2.new(1, -20, 0, 6); bar.Position = UDim2.new(0, 10, 0, 35); bar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            
            local fill = Instance.new("Frame", bar)
            fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)

            local function update(input)
                local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                local val = math.floor(min + (max - min) * pos)
                lab.Text = text .. ": " .. val
                cb(val)
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local conn; conn = UserInputService.InputChanged:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then conn:Disconnect() end
                    end)
                    update(input)
                end
            end)
            return reg(sliderFrame)
        end

        return sect
    end
    return tabInterface
end

function CryoLib:ActivateTab(tabData)
    for _, t in ipairs(self.tabs) do
        SafeTween(t.btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(25, 25, 30), TextColor3 = Color3.fromRGB(150, 150, 160)})
        for _, el in ipairs(t.elements) do el.Visible = false end
    end
    SafeTween(tabData.btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(100, 150, 255), TextColor3 = Color3.new(1,1,1)})
    for _, el in ipairs(tabData.elements) do el.Visible = true end
end

function CryoLib:Toggle()
    self.isOpen = not self.isOpen
    self.mainPanel.Visible = true
    local targetSize = self.isOpen and self.originalSize or UDim2.new(0,0,0,0)
    local targetPos = self.isOpen and UDim2.new(0.5, -225, 0.5, -275) or UDim2.new(0.5, 0, 0.5, 0)
    SafeTween(self.mainPanel, TweenInfo.new(0.4, Enum.EasingStyle.Back), {Size = targetSize, Position = targetPos})
end

function CryoLib:Internal_SetupDragging()
    local drag, start, startPos
    self.header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; start = i.Position; startPos = self.mainPanel.Position
            i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = i.Position - start
            self.mainPanel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function CryoLib:Internal_CreateFloatingButton()
    local fb = Instance.new("ImageButton", self.gui)
    fb.Size = UDim2.new(0, 55, 0, 55); fb.Position = UDim2.new(0, 15, 0.5, -27)
    fb.BackgroundColor3 = Color3.fromRGB(30, 30, 35); fb.Image = "rbxassetid://9751678226"
    fb.ZIndex = 100
    Instance.new("UICorner", fb).CornerRadius = UDim.new(1, 0)
    local s = Instance.new("UIStroke", fb)
    s.Color = Color3.fromRGB(100, 150, 255); s.Thickness = 2
    fb.MouseButton1Click:Connect(function() self:Toggle() end)
end

function CryoLib:Notify(t, m) print(t .. ": " .. m) end

return CryoLib
