local CryoLib = {}

function CryoLib:CreateWindow(hubName)
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    local libData = {
        tabs = {},
        accent = Color3.fromRGB(100, 150, 255),
        visible = true
    }

    -- [[ ГЛАВНЫЙ GUI ]]
    local gui = Instance.new("ScreenGui")
    gui.Name = "CryoLib_Premium_Final"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- [[ ПЛАВАЮЩАЯ КНОПКА ]]
    local floatBtn = Instance.new("ImageButton")
    floatBtn.Size = UDim2.new(0, 50, 0, 50)
    floatBtn.Position = UDim2.new(0, 20, 0.5, -25)
    floatBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    floatBtn.Image = "rbxassetid://12129379472" -- ОБНОВЛЕННЫЙ ID
    floatBtn.ZIndex = 100
    floatBtn.Parent = gui
    Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(1, 0)
    local fStroke = Instance.new("UIStroke", floatBtn)
    fStroke.Color = libData.accent
    fStroke.Thickness = 2

    -- Драг кнопки
    local fDrag = false local fS, fP
    floatBtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = true fS = i.Position fP = floatBtn.Position end end)
    UserInputService.InputChanged:Connect(function(i) if fDrag and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - fS floatBtn.Position = UDim2.new(fP.X.Scale, fP.X.Offset + d.X, fP.Y.Scale, fP.Y.Offset + d.Y)
    end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = false end end)

    -- [[ ГЛАВНАЯ ПАНЕЛЬ ]]
    local mainPanel = Instance.new("Frame")
    mainPanel.Size = UDim2.new(0, 420, 0, 520)
    mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    mainPanel.Parent = gui
    Instance.new("UICorner", mainPanel).CornerRadius = UDim.new(0, 20)
    local mainStroke = Instance.new("UIStroke", mainPanel)
    mainStroke.Color = Color3.fromRGB(45, 45, 55)
    mainStroke.Thickness = 2

    local function toggleGui()
        libData.visible = not libData.visible
        mainPanel.Visible = libData.visible
    end

    floatBtn.MouseButton1Click:Connect(toggleGui)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.K then toggleGui() end
    end)

    -- [[ HEADER ]]
    local header = Instance.new("Frame", mainPanel)
    header.Size = UDim2.new(1, 0, 0, 50); header.BackgroundTransparency = 1

    local headerLogo = Instance.new("ImageLabel", header)
    headerLogo.Size = UDim2.new(0, 30, 0, 30)
    headerLogo.Position = UDim2.new(0, 15, 0.5, -15)
    headerLogo.BackgroundTransparency = 1
    headerLogo.Image = "rbxassetid://104331218636380" -- ОБНОВЛЕННЫЙ ID
    headerLogo.Parent = header

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -150, 1, 0); title.Position = UDim2.new(0, 55, 0, 0)
    title.Text = hubName; title.Font = "GothamBlack"; title.TextColor3 = Color3.new(1,1,1); title.TextXAlignment = "Left"; title.TextSize = 18; title.BackgroundTransparency = 1

    local closeBtn = Instance.new("TextButton", header)
    closeBtn.Size = UDim2.new(0, 30, 0, 30); closeBtn.Position = UDim2.new(1, -40, 0, 10)
    closeBtn.Text = "×"; closeBtn.TextColor3 = Color3.fromRGB(255, 80, 80); closeBtn.BackgroundTransparency = 1; closeBtn.TextSize = 28; closeBtn.Font = "GothamBlack"
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    local hideBtn = Instance.new("TextButton", header)
    hideBtn.Size = UDim2.new(0, 30, 0, 30); hideBtn.Position = UDim2.new(1, -75, 0, 10)
    hideBtn.Text = "−"; hideBtn.TextColor3 = Color3.new(0.7,0.7,0.7); hideBtn.BackgroundTransparency = 1; hideBtn.TextSize = 28; hideBtn.Font = "GothamBlack"
    hideBtn.MouseButton1Click:Connect(toggleGui)

    -- Драг панели
    local dDragging, dStart, dInput
    header.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dDragging = true dInput = i.Position dStart = mainPanel.Position end end)
    UserInputService.InputChanged:Connect(function(i) if dDragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dInput mainPanel.Position = UDim2.new(dStart.X.Scale, dStart.X.Offset + d.X, dStart.Y.Scale, dStart.Y.Offset + d.Y)
    end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dDragging = false end end)

    -- [[ КОНТЕЙНЕРЫ ]]
    local tabContainer = Instance.new("Frame", mainPanel)
    tabContainer.Size = UDim2.new(0, 100, 1, -50); tabContainer.Position = UDim2.new(0, 0, 0, 50); tabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 16); tabContainer.BorderSizePixel = 0
    Instance.new("UICorner", tabContainer).CornerRadius = UDim.new(0, 20)

    local contentArea = Instance.new("Frame", mainPanel)
    contentArea.Size = UDim2.new(1, -100, 1, -50); contentArea.Position = UDim2.new(0, 100, 0, 50); contentArea.BackgroundTransparency = 1

    function libData:CreateTab(name)
        local tabObj = {}
        local scroll = Instance.new("ScrollingFrame", contentArea)
        scroll.Size = UDim2.new(1, -20, 1, -20); scroll.Position = UDim2.new(0, 10, 0, 10); scroll.Visible = false; scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0; scroll.ScrollBarThickness = 2; scroll.ScrollBarImageColor3 = libData.accent
        local layout = Instance.new("UIListLayout", scroll); layout.Padding = UDim.new(0, 8)
        layout.Changed:Connect(function() scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10) end)

        local btn = Instance.new("TextButton", tabContainer)
        btn.Size = UDim2.new(1, 0, 0, 40); btn.Position = UDim2.new(0, 0, 0, #libData.tabs * 42); btn.Text = name; btn.BackgroundTransparency = 1; btn.TextColor3 = Color3.new(0.5,0.5,0.5); btn.Font = "GothamBold"; btn.TextSize = 13

        btn.MouseButton1Click:Connect(function()
            for _, t in ipairs(libData.tabs) do t.s.Visible = false t.b.TextColor3 = Color3.new(0.5,0.5,0.5) end
            scroll.Visible = true; btn.TextColor3 = Color3.new(1,1,1)
        end)
        table.insert(libData.tabs, {s = scroll, b = btn})
        if #libData.tabs == 1 then scroll.Visible = true; btn.TextColor3 = Color3.new(1,1,1) end

        -- [[ ЭЛЕМЕНТЫ ]]
        function tabObj:CreateLabel(txt)
            local l = Instance.new("TextLabel", scroll); l.Size = UDim2.new(1, 0, 0, 25); l.Text = txt; l.TextColor3 = libData.accent; l.Font = "GothamBold"; l.BackgroundTransparency = 1; l.TextSize = 14; l.TextXAlignment = "Left"
        end

        function tabObj:CreateToggle(txt, callback)
            local state = false
            local f = Instance.new("Frame", scroll); f.Size = UDim2.new(1, -5, 0, 45); f.BackgroundColor3 = Color3.fromRGB(25, 25, 32); Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
            local l = Instance.new("TextLabel", f); l.Size = UDim2.new(1, -60, 1, 0); l.Position = UDim2.new(0, 12, 0, 0); l.Text = txt; l.Font = "GothamBold"; l.TextColor3 = Color3.new(1,1,1); l.BackgroundTransparency = 1; l.TextXAlignment = "Left"; l.TextSize = 14
            local bg = Instance.new("Frame", f); bg.Size = UDim2.new(0, 38, 0, 20); bg.Position = UDim2.new(1, -48, 0.5, -10); bg.BackgroundColor3 = Color3.fromRGB(45, 45, 55); Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
            local c = Instance.new("Frame", bg); c.Size = UDim2.new(0, 16, 0, 16); c.Position = UDim2.new(0, 2, 0.5, -8); c.BackgroundColor3 = Color3.new(1,1,1); Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
            local b = Instance.new("TextButton", f); b.Size = UDim2.new(1, 0, 1, 0); b.BackgroundTransparency = 1; b.Text = ""
            b.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(bg, TweenInfo.new(0.3), {BackgroundColor3 = state and libData.accent or Color3.fromRGB(45, 45, 55)}):Play()
                TweenService:Create(c, TweenInfo.new(0.3), {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                callback(state)
            end)
        end

        -- [[ ОБНОВЛЕННЫЙ SLIDER ПО ТВОЕМУ ЗАПРОСУ ]]
        function tabObj:CreateSlider(text, min, max, default, callback)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -10, 0, 60)
            frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            frame.BorderSizePixel = 0
            frame.Parent = scroll

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 8)
            corner.Parent = frame

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -20, 0, 20)
            label.Position = UDim2.new(0, 12, 0, 8)
            label.BackgroundTransparency = 1
            label.Text = text .. ": " .. default
            label.Font = Enum.Font.GothamBold
            label.TextSize = 14
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, -30, 0, 6)
            track.Position = UDim2.new(0, 15, 0, 38)
            track.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            track.BorderSizePixel = 0
            track.Parent = frame

            local trackCorner = Instance.new("UICorner")
            trackCorner.CornerRadius = UDim.new(1, 0)
            trackCorner.Parent = track

            local fill = Instance.new("Frame")
            local initPercent = math.clamp((default - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(initPercent, 0, 1, 0)
            fill.BackgroundColor3 = libData.accent
            fill.BorderSizePixel = 0
            fill.Parent = track

            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = fill

            local handle = Instance.new("Frame")
            handle.Size = UDim2.new(0, 14, 0, 14)
            handle.Position = UDim2.new(initPercent, -7, 0.5, -7)
            handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            handle.BorderSizePixel = 0
            handle.Parent = track

            local handleCorner = Instance.new("UICorner")
            handleCorner.CornerRadius = UDim.new(1, 0)
            handleCorner.Parent = handle

            local dragging = false
            local function update()
                local mousePos = UserInputService:GetMouseLocation().X
                local barPos = track.AbsolutePosition.X
                local barSize = track.AbsoluteSize.X
                local m = math.clamp((mousePos - barPos) / barSize, 0, 1)
                local val = math.floor(min + (m * (max - min)))
                
                label.Text = text .. ": " .. val
                fill.Size = UDim2.new(m, 0, 1, 0)
                handle.Position = UDim2.new(m, -7, 0.5, -7)
                callback(val)
            end

            track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    update()
                end
            end)

            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    update()
                end
            end)

            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
        end

        function tabObj:CreateButton(txt, callback)
            local b = Instance.new("TextButton", scroll); b.Size = UDim2.new(1, -5, 0, 40); b.BackgroundColor3 = libData.accent; b.Text = txt; b.Font = "GothamBlack"; b.TextColor3 = Color3.new(1,1,1); b.TextSize = 14; Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
            b.MouseButton1Click:Connect(callback)
        end
        return tabObj
    end
    return libData
end

return CryoLib
