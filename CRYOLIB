local Lib = loadstring(game:HttpGet("https://raw.githubusercontent.com/xlebaaa3-netizen/UIMAIN/refs/heads/main/CRYOLIB"))()
local hub = Lib("Tool Grabber")
local mainTab = hub:AddTab("Main")

mainTab:AddButton("Get All Tools", function()
    print("Кнопка нажата!")
    local toolsFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Tools")
    if toolsFolder then
        for _, tool in pairs(toolsFolder:GetChildren()) do
            if tool:IsA("Tool") then
                tool:Clone().Parent = game.Players.LocalPlayer.Backpack
            end
        end
        print("Готово!")
    end
end)

mainTab:AddLabel("━━━━━━━━━━━━━━━━━━")
mainTab:AddLabel("📁 ReplicatedStorage.Tools")
