-- ==================== CRYO LIBRARY (ИСПРАВЛЕННАЯ) ====================
-- Подключение: local Lib = loadstring(game:HttpGet("ссылка_на_этот_файл"))()
-- Использование: local hub = Lib("Название")

local CryoLib = {}
CryoLib.__index = CryoLib

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

function CryoLib:new(title)
    local self = setmetatable({}, CryoLib)
    
    self.gui = Instance.new("ScreenGui")
    self.gui.Name = "CryoLibGUI"
    self.gui.ResetOnSpawn = false
    self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.gui.Parent = PlayerGui
    
    self.isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    self.currentTab = nil
    self.tabs = {}
    self.elements = {}
    
    self:CreateMainPanel(title)
    self:CreateFloatingButton()
    
    return self
end

