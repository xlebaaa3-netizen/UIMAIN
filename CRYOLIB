    self.mainPanel = Instance.new("Frame")
    self.mainPanel.Size = UDim2.new(0, 420, 0, 520)
    self.mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    self.mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    self.mainPanel.BackgroundTransparency = 0
    self.mainPanel.BorderSizePixel = 0
    self.mainPanel.Active = true
    self.mainPanel.Draggable = false
    self.mainPanel.Visible = false
    self.mainPanel.Parent = self.gui
    
    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 12)
    mainCorner.Parent = self.mainPanel
    
    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = Color3.fromRGB(60, 60, 80)
    mainStroke.Thickness = 1.5
    mainStroke.Parent = self.mainPanel
    
    self:CreateHeader(title)
    self:CreateTabContainer()
    self:CreateContentArea()
    self:SetupDragging()
end

