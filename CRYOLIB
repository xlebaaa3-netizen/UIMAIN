local CryoLib = {}
CryoLib.__index = CryoLib

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function SafeCall(callback, ...)
	if type(callback) == "function" then
		local success, err = pcall(callback, ...)
		if not success then warn("[CryoLib] Callback error: " .. tostring(err)) end
	end
end

local function SafeTween(instance, tweenInfo, properties)
	if not instance or not instance.Parent then return nil end
	local success, result = pcall(function()
		return TweenService:Create(instance, tweenInfo, properties)
	end)
	if success then return result else return nil end
end

-- ==================== CREATE WINDOW ====================
function CryoLib:CreateWindow(title)
	local existing = PlayerGui:FindFirstChild("CryoLibGUI")
	if existing then pcall(function() existing:Destroy() end) end

	local self = setmetatable({}, CryoLib)
	self._destroyed = false
	self.isOpen = false
	self.minimized = false
	self.connections = {}
	self.tabs = {}
	self.currentTab = nil

	self.gui = Instance.new("ScreenGui")
	self.gui.Name = "CryoLibGUI"
	self.gui.ResetOnSpawn = false
	self.gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.gui.Parent = PlayerGui

	self:CreateMainPanel(title)
	self:CreateFloatingButton()
	self:SetupHotkey()

	return self
end

