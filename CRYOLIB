function CryoLib:CreateFloatingButton()
	self.floatingBtn = Instance.new("ImageButton")
	self.floatingBtn.Name = "CryoLibFloat"
	self.floatingBtn.Size = UDim2.new(0, 55, 0, 55)
	self.floatingBtn.Position = UDim2.new(0, 20, 0.5, -27)
	self.floatingBtn.BackgroundTransparency = 1
	self.floatingBtn.Image = "rbxassetid://9751678226"
	self.floatingBtn.ImageColor3 = Color3.fromRGB(255, 255, 255)
	self.floatingBtn.ScaleType = Enum.ScaleType.Fit
	self.floatingBtn.Active = true
	self.floatingBtn.Draggable = false
	self.floatingBtn.Parent = self.gui

	local floatCorner = Instance.new("UICorner")
	floatCorner.CornerRadius = UDim.new(1, 0)
	floatCorner.Parent = self.floatingBtn

	local floatStroke = Instance.new("UIStroke")
	floatStroke.Color = Color3.fromRGB(100, 150, 255)
	floatStroke.Thickness = 2
	floatStroke.Parent = self.floatingBtn

	local isDragging = false
	local dragStart = nil
	local startPos = nil

	self.floatingBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = self.floatingBtn.AbsolutePosition
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			if self.floatingBtn and self.floatingBtn.Parent then
				self.floatingBtn.Position = UDim2.new(0, startPos.X + delta.X, 0, startPos.Y + delta.Y)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)

	self.floatingBtn.MouseButton1Click:Connect(function()
		if not isDragging then
			self:Toggle()
		end
	end)
end

