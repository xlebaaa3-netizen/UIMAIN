local CryoLib = {}

local function tableFind(t, val)
    for i, v in next, t do
        if v == val then return i end
    end
    return nil
end

function CryoLib:CreateWindow(title)
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local player = Players.LocalPlayer

    local accentColor = Color3.fromRGB(120, 170, 255)
    local guiKey = "K"

    local windowData = {
        tabs = {},
        toggles = {},
        dropdowns = {},
        keybinds = {},
        visible = true,
        closed = false,
        minimized = false
    }

    local connections = {}
    local function track(conn) table.insert(connections, conn); return conn end

    local function closeAllDropdowns()
        for _, dd in ipairs(windowData.dropdowns) do
            if dd.open then dd.close() end
        end
    end

    local function addGlow(frame, color)
        local stroke = Instance.new("UIStroke")
        stroke.Color = color; stroke.Thickness = 2; stroke.Transparency = 0.3
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Parent = frame
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CryoLib"; screenGui.ResetOnSpawn = false; screenGui.DisplayOrder = 999
    screenGui.Parent = player:WaitForChild("PlayerGui")

    local dropdownOverlay = Instance.new("Frame")
    dropdownOverlay.Size = UDim2.new(1,0,1,0); dropdownOverlay.BackgroundTransparency = 1
    dropdownOverlay.ZIndex = 1000; dropdownOverlay.ClipsDescendants = true; dropdownOverlay.Parent = screenGui

    local floatButton = Instance.new("ImageButton")
    floatButton.Size = UDim2.new(0,48,0,48); floatButton.Position = UDim2.new(0,24,0.5,-24)
    floatButton.BackgroundColor3 = Color3.fromRGB(20,20,28); floatButton.Image = "rbxassetid://12129379472"
    floatButton.ZIndex = 100; floatButton.Parent = screenGui
    Instance.new("UICorner", floatButton).CornerRadius = UDim.new(1,0)
    addGlow(floatButton, accentColor)

    local isDragging, dragStart, dragPos
    track(floatButton.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then isDragging=true; dragStart=i.Position; dragPos=floatButton.Position end
    end))
    track(UserInputService.InputChanged:Connect(function(i)
        if isDragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            local d=i.Position-dragStart; floatButton.Position=UDim2.new(dragPos.X.Scale,dragPos.X.Offset+d.X,dragPos.Y.Scale,dragPos.Y.Offset+d.Y)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then isDragging=false end end))

    local mainPanel = Instance.new("Frame")
    mainPanel.Size=UDim2.new(0,440,0,540); mainPanel.Position=UDim2.new(0.5,-220,0.5,-270)
    mainPanel.BackgroundColor3=Color3.fromRGB(18,18,24); mainPanel.ClipsDescendants=true; mainPanel.ZIndex=10; mainPanel.Parent=screenGui
    Instance.new("UICorner",mainPanel).CornerRadius=UDim.new(0,16); addGlow(mainPanel,accentColor)

    local tabPanel=Instance.new("Frame")
    tabPanel.Size=UDim2.new(0,110,1,-54); tabPanel.Position=UDim2.new(0,0,0,54)
    tabPanel.BackgroundColor3=Color3.fromRGB(15,15,20); tabPanel.BorderSizePixel=0; tabPanel.ZIndex=11; tabPanel.Parent=mainPanel
    Instance.new("UICorner",tabPanel).CornerRadius=UDim.new(0,16)
    local tabPatch=Instance.new("Frame"); tabPatch.Size=UDim2.new(0.5,0,1,0); tabPatch.Position=UDim2.new(0.5,0,0,0)
    tabPatch.BackgroundColor3=Color3.fromRGB(15,15,20); tabPatch.BorderSizePixel=0; tabPatch.ZIndex=11; tabPatch.Parent=tabPanel

    local contentArea=Instance.new("Frame")
    contentArea.Size=UDim2.new(1,-110,1,-54); contentArea.Position=UDim2.new(0,110,0,54)
    contentArea.BackgroundTransparency=1; contentArea.ZIndex=11; contentArea.Parent=mainPanel

    local normalSize=UDim2.new(0,440,0,540); local normalPos=UDim2.new(0.5,-220,0.5,-270); local miniSize=UDim2.new(0,440,0,54)

    local function showPanel()
        mainPanel.Visible=true; TweenService:Create(mainPanel,TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=normalSize,Position=normalPos}):Play()
        tabPanel.Visible=true; contentArea.Visible=true; windowData.minimized=false
    end
    local function hidePanel()
        closeAllDropdowns()
        TweenService:Create(mainPanel,TweenInfo.new(0.3,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Size=UDim2.new(0,0,0,0),Position=UDim2.new(0.5,0,0.5,0)}):Play()
        task.delay(0.3,function() mainPanel.Visible=false; mainPanel.Size=normalSize; mainPanel.Position=normalPos end)
    end
    local function toggleMinimize()
        closeAllDropdowns()
        if windowData.minimized then
            TweenService:Create(mainPanel,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=normalSize}):Play()
            tabPanel.Visible=true; contentArea.Visible=true; windowData.minimized=false
        else
            TweenService:Create(mainPanel,TweenInfo.new(0.3,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Size=miniSize}):Play()
            tabPanel.Visible=false; contentArea.Visible=false; windowData.minimized=true
        end
    end
    local function closePanel()
        if windowData.closed then return end
        windowData.closed=true; closeAllDropdowns()
        for _,t in ipairs(windowData.toggles) do
            if t.active then t.active=false; t.callback(false)
                if t.bg then TweenService:Create(t.bg,TweenInfo.new(0.25),{BackgroundColor3=Color3.fromRGB(50,50,65)}):Play() end
                if t.knob then TweenService:Create(t.knob,TweenInfo.new(0.25),{Position=UDim2.new(0,2,0.5,-9)}):Play() end
            end
        end
        TweenService:Create(mainPanel,TweenInfo.new(0.5,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Size=UDim2.new(0,0,0,0),Position=UDim2.new(0.5,0,0.5,0)}):Play()
        TweenService:Create(floatButton,TweenInfo.new(0.4),{Size=UDim2.new(0,0,0,0),Position=UDim2.new(0.5,0,0.5,0)}):Play()
        task.delay(0.6,function() for _,c in ipairs(connections) do if c then c:Disconnect() end end; screenGui:Destroy() end)
    end
    local function toggleGui() windowData.visible=not windowData.visible; if windowData.visible then showPanel() else hidePanel() end end
    floatButton.MouseButton1Click:Connect(toggleGui)

    local guiKeyConnection
    local function setGuiKeybind(key)
        if guiKeyConnection then guiKeyConnection:Disconnect() end; guiKey=key
        guiKeyConnection=UserInputService.InputBegan:Connect(function(i,g) if not g and i.KeyCode==Enum.KeyCode[key] then toggleGui() end end)
    end
    setGuiKeybind("K")
    function windowData:SetGuiKey(k) setGuiKeybind(k) end
    function windowData:GetGuiKey() return guiKey end

    -- Header, buttons, drag, etc. (same as before, omitted for brevity but included in full file)
    -- ... (keep all header/logo/buttons/drag code from your version, they are fine)

    function windowData:CreateTab(name)
        -- ... (keep CreateTab, Toggle, Slider, Button, Label, Keybind, ColorPicker code from your version)

        function tab:CreateDropdown(text, options, multi, callback)
            local selected = multi and {} or (options[1] or "")
            local open = false; local items = {}
            local frame = Instance.new("Frame"); frame.Size=UDim2.new(1,-4,0,48); frame.BackgroundColor3=Color3.fromRGB(28,28,36); frame.BorderSizePixel=0; frame.ZIndex=11; frame.Parent=scroll
            Instance.new("UICorner",frame).CornerRadius=UDim.new(0,10)
            local label=Instance.new("TextLabel"); label.Size=UDim2.new(1,-50,1,0); label.Position=UDim2.new(0,14,0,0)
            label.Text=text..": "..(multi and "None" or tostring(selected)); label.Font=Enum.Font.GothamBold; label.TextColor3=Color3.fromRGB(220,220,235)
            label.BackgroundTransparency=1; label.TextXAlignment=Enum.TextXAlignment.Left; label.TextSize=14; label.ZIndex=12; label.Parent=frame
            local arrowLabel=Instance.new("TextLabel"); arrowLabel.Size=UDim2.new(0,24,0,24); arrowLabel.Position=UDim2.new(1,-34,0.5,-12)
            arrowLabel.BackgroundTransparency=1; arrowLabel.Text="▼"; arrowLabel.Font=Enum.Font.GothamBold; arrowLabel.TextSize=12; arrowLabel.TextColor3=Color3.fromRGB(150,150,165); arrowLabel.ZIndex=12; arrowLabel.Parent=frame
            local clickBtn=Instance.new("TextButton"); clickBtn.Size=UDim2.new(1,0,1,0); clickBtn.BackgroundTransparency=1; clickBtn.Text=""; clickBtn.ZIndex=14; clickBtn.Parent=frame

            local listFrame=Instance.new("Frame"); listFrame.Size=UDim2.new(0,0,0,0); listFrame.BackgroundColor3=Color3.fromRGB(32,32,42); listFrame.BorderSizePixel=0; listFrame.ZIndex=1001; listFrame.Visible=false; listFrame.ClipsDescendants=true; listFrame.Parent=dropdownOverlay
            Instance.new("UICorner",listFrame).CornerRadius=UDim.new(0,10)
            local listScroll=Instance.new("ScrollingFrame"); listScroll.Size=UDim2.new(1,-8,1,-8); listScroll.Position=UDim2.new(0,4,0,4); listScroll.BackgroundTransparency=1
            listScroll.BorderSizePixel=0; listScroll.ScrollBarThickness=2; listScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y; listScroll.CanvasSize=UDim2.new(0,0,0,0); listScroll.ZIndex=1002; listScroll.Parent=listFrame
            local listLayout=Instance.new("UIListLayout"); listLayout.Padding=UDim.new(0,2); listLayout.SortOrder=Enum.SortOrder.LayoutOrder; listLayout.Parent=listScroll
            local listPadding=Instance.new("UIPadding"); listPadding.PaddingTop=UDim.new(0,2); listPadding.PaddingBottom=UDim.new(0,2); listPadding.Parent=listScroll

            local currentWidth, currentHeight = 0, 0

            local function updateLabel()
                if multi then local n=#selected; label.Text=text..": "..(n==0 and "None" or n==1 and selected[1] or n.." selected")
                else label.Text=text..": "..tostring(selected) end
            end
            local function updateItems()
                for _,item in ipairs(items) do
                    local sel=multi and tableFind(selected,item.option)~=nil or selected==item.option
                    item.indicator.BackgroundColor3=sel and accentColor or Color3.fromRGB(50,50,65)
                    for _,c in ipairs(item.indicator:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
                    if multi and sel then
                        local ck=Instance.new("TextLabel"); ck.Size=UDim2.new(1,0,1,0); ck.BackgroundTransparency=1; ck.Text="✓"; ck.Font=Enum.Font.GothamBold; ck.TextSize=10; ck.TextColor3=Color3.fromRGB(255,255,255); ck.ZIndex=1005; ck.Parent=item.indicator
                    end
                end
            end

            local function makeItem(option)
                local ib=Instance.new("TextButton"); ib.Size=UDim2.new(1,0,0,32); ib.BackgroundTransparency=1; ib.Text="  "..option
                ib.Font=Enum.Font.GothamBold; ib.TextSize=13; ib.TextColor3=Color3.fromRGB(180,180,200); ib.TextXAlignment=Enum.TextXAlignment.Left; ib.ZIndex=1003; ib.Parent=listScroll
                local ind=Instance.new("Frame"); ind.Size=UDim2.new(0,16,0,16); ind.Position=UDim2.new(1,-24,0.5,-8)
                ind.BackgroundColor3=Color3.fromRGB(50,50,65); ind.BorderSizePixel=0; ind.ZIndex=1004; ind.Parent=ib
                Instance.new("UICorner",ind).CornerRadius=UDim.new(multi and 0 or 1,multi and 3 or 0)
                ib.MouseButton1Click:Connect(function()
                    if multi then local f=tableFind(selected,option); if f then table.remove(selected,f) else table.insert(selected,option) end; updateItems(); callback(selected)
                    else selected=option; updateItems(); callback(selected)
                        open=false; arrowLabel.Text="▼"
                        TweenService:Create(listFrame,TweenInfo.new(0.15,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Size=UDim2.new(0,currentWidth,0,0)}):Play()
                        task.delay(0.15,function() listFrame.Visible=false end)
                    end; updateLabel()
                end)
                table.insert(items,{button=ib,indicator=ind,option=option})
            end
            for _,opt in ipairs(options) do makeItem(opt) end

            local maxHeight=math.min(#options*34+4,160)

            local function positionList()
                local ap,az=frame.AbsolutePosition,frame.AbsoluteSize; local ss=workspace.CurrentCamera.ViewportSize
                local yPos=ap.Y+az.Y+2; currentHeight=maxHeight
                if yPos+currentHeight>ss.Y-10 then yPos=ap.Y-currentHeight-2; if yPos<10 then yPos=10; currentHeight=ap.Y-14 end end
                local xPos=ap.X; currentWidth=az.X
                if xPos+currentWidth>ss.X-10 then xPos=ss.X-currentWidth-10 end
                if xPos<10 then xPos=10; currentWidth=math.min(currentWidth,ss.X-20) end
                listFrame.Position=UDim2.new(0,xPos,0,yPos)
            end

            local function openDropdown()
                open=true; arrowLabel.Text="▲"; positionList(); listFrame.Visible=true; updateItems()
                listFrame.Size=UDim2.new(0,currentWidth,0,0)
                TweenService:Create(listFrame,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Size=UDim2.new(0,currentWidth,0,currentHeight)}):Play()
            end
            local function closeDropdown()
                open=false; arrowLabel.Text="▼"
                TweenService:Create(listFrame,TweenInfo.new(0.15,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Size=UDim2.new(0,currentWidth,0,0)}):Play()
                task.delay(0.15,function() listFrame.Visible=false end)
            end

            clickBtn.MouseButton1Click:Connect(function() if open then closeDropdown() else closeAllDropdowns(); openDropdown() end end)
            local posConn=RunService.RenderStepped:Connect(function() if open then positionList() end end)

            local ddData={open=false,listFrame=listFrame,buttonFrame=frame,close=function() open=false; arrowLabel.Text="▼"; TweenService:Create(listFrame,TweenInfo.new(0.15,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{Size=UDim2.new(0,currentWidth,0,0)}):Play(); task.delay(0.15,function() listFrame.Visible=false end) end}
            table.insert(windowData.dropdowns,ddData)
            return {GetSelected=function() return multi and selected or selected end, SetSelected=function(v) if multi then selected=type(v)=="table" and v or {v} else selected=v end; updateLabel(); updateItems() end}
        end

        return tab
    end

    function windowData:GetToggle(name) for _,t in ipairs(windowData.toggles) do if t.name==name then return t end end end
    return windowData
end

return CryoLib
