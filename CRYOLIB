        end

        -- DROPDOWN
        function tabObj:CreateDropdown(text, options, multiSelect, callback)
            local selected = multiSelect and {} or (options[1] or "")
            local open = false; local itemData = {}
            local f = Instance.new("Frame", scroll); f.Size = UDim2.new(1, -4, 0, 48); f.BackgroundColor3 = Color3.fromRGB(28, 28, 36); f.BorderSizePixel = 0; f.ZIndex = 11
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
            local l = Instance.new("TextLabel", f); l.Size = UDim2.new(1, -50, 1, 0); l.Position = UDim2.new(0, 14, 0, 0); l.Text = text .. ": " .. (multiSelect and "None" or tostring(selected))
            l.Font = Enum.Font.GothamBold; l.TextColor3 = Color3.fromRGB(220, 220, 235); l.BackgroundTransparency = 1; l.TextXAlignment = Enum.TextXAlignment.Left; l.TextSize = 14; l.ZIndex = 12
            local arrow = Instance.new("TextLabel", f); arrow.Size = UDim2.new(0, 24, 0, 24); arrow.Position = UDim2.new(1, -34, 0.5, -12); arrow.BackgroundTransparency = 1; arrow.Text = "V"; arrow.Font = Enum.Font.GothamBold; arrow.TextSize = 12; arrow.TextColor3 = Color3.fromRGB(150, 150, 165); arrow.ZIndex = 12
            local clickBtn = Instance.new("TextButton", f); clickBtn.Size = UDim2.new(1, 0, 1, 0); clickBtn.BackgroundTransparency = 1; clickBtn.Text = ""; clickBtn.ZIndex = 14
            local listFrame = Instance.new("Frame"); listFrame.Size = UDim2.new(0, 0, 0, 0); listFrame.BackgroundColor3 = Color3.fromRGB(32, 32, 42); listFrame.BorderSizePixel = 0; listFrame.ZIndex = 1001; listFrame.Visible = false; listFrame.ClipsDescendants = true; listFrame.Parent = dropdownOverlay
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 10)
            local listScroll = Instance.new("ScrollingFrame", listFrame); listScroll.Size = UDim2.new(1, -8, 1, -8); listScroll.Position = UDim2.new(0, 4, 0, 4); listScroll.BackgroundTransparency = 1; listScroll.BorderSizePixel = 0; listScroll.ScrollBarThickness = 2; listScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; listScroll.CanvasSize = UDim2.new(0, 0, 0, 0); listScroll.ZIndex = 1002
            local listLayout = Instance.new("UIListLayout", listScroll); listLayout.Padding = UDim.new(0, 2); listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            local listPadding = Instance.new("UIPadding", listScroll); listPadding.PaddingTop = UDim.new(0, 2); listPadding.PaddingBottom = UDim.new(0, 2)
            
            local function updateLabel()
                if multiSelect then local n = #selected; l.Text = text .. ": " .. (n == 0 and "None" or n == 1 and selected[1] or n .. " selected")
                else l.Text = text .. ": " .. tostring(selected) end
            end
            local function updateItems()
                for _, d in ipairs(itemData) do
                    local s = multiSelect and tableFind(selected, d.opt) ~= nil or selected == d.opt
                    d.indicator.BackgroundColor3 = s and libData.accent or Color3.fromRGB(50, 50, 65)
                    for _, ch in ipairs(d.indicator:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
                    if multiSelect and s then
                        local ck = Instance.new("TextLabel", d.indicator); ck.Size = UDim2.new(1, 0, 1, 0); ck.BackgroundTransparency = 1; ck.Text = "Y"; ck.Font = Enum.Font.GothamBold; ck.TextSize = 10; ck.TextColor3 = Color3.fromRGB(255, 255, 255); ck.ZIndex = 1005
                    end
                end
            end
            local function createItem(opt)
                local ib = Instance.new("TextButton", listScroll); ib.Size = UDim2.new(1, 0, 0, 32); ib.BackgroundTransparency = 1; ib.Text = "  " .. opt; ib.Font = Enum.Font.GothamBold; ib.TextSize = 13; ib.TextColor3 = Color3.fromRGB(180, 180, 200); ib.TextXAlignment = Enum.TextXAlignment.Left; ib.ZIndex = 1003
                local ind = Instance.new("Frame", ib); ind.Size = UDim2.new(0, 16, 0, 16); ind.Position = UDim2.new(1, -24, 0.5, -8); ind.BackgroundColor3 = Color3.fromRGB(50, 50, 65); ind.BorderSizePixel = 0; ind.ZIndex = 1004
                Instance.new("UICorner", ind).CornerRadius = UDim.new(multiSelect and 0 or 1, multiSelect and 3 or 0)
                ib.MouseButton1Click:Connect(function()
                    if multiSelect then local f = tableFind(selected, opt); if f then table.remove(selected, f) else table.insert(selected, opt) end; updateItems(); callback(selected)
                    else selected = opt; updateItems(); callback(selected); closeDropdown() end; updateLabel()
                end)
                table.insert(itemData, {btn = ib, indicator = ind, opt = opt})
            end
            for _, opt in ipairs(options) do createItem(opt) end
            local maxH = math.min(#options * 34 + 4, 160)
            local function positionList() local ap, az = f.AbsolutePosition, f.AbsoluteSize; listFrame.Position = UDim2.new(0, ap.X, 0, ap.Y + az.Y + 2); listFrame.Size = UDim2.new(0, az.X, 0, listFrame.Size.Y.Offset) end
            local function openDropdown() open = true; arrow.Text = "A"; positionList(); listFrame.Visible = true; updateItems(); TweenService:Create(listFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, listFrame.Size.X.Offset, 0, maxH)}):Play() end
