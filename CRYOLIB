            local r, g, b = math.floor(currentColor.R * 255), math.floor(currentColor.G * 255), math.floor(currentColor.B * 255)
            local expanded = false
            
            local f = Instance.new("Frame", scroll); f.Size = UDim2.new(1, -4, 0, 52); f.BackgroundColor3 = Color3.fromRGB(28, 28, 36); f.BorderSizePixel = 0; f.ZIndex = 11
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10); f.ClipsDescendants = true
            local l = Instance.new("TextLabel", f); l.Size = UDim2.new(0, 150, 0, 52); l.Position = UDim2.new(0, 14, 0, 0); l.Text = text
            l.Font = Enum.Font.GothamBold; l.TextColor3 = Color3.fromRGB(220, 220, 235); l.BackgroundTransparency = 1; l.TextXAlignment = Enum.TextXAlignment.Left; l.TextSize = 14; l.ZIndex = 12
            local prev = Instance.new("Frame", f); prev.Size = UDim2.new(0, 32, 0, 32); prev.Position = UDim2.new(1, -52, 0, 10); prev.BackgroundColor3 = currentColor; prev.BorderSizePixel = 0; prev.ZIndex = 12
            Instance.new("UICorner", prev).CornerRadius = UDim.new(0, 8); local prevStroke = Instance.new("UIStroke", prev); prevStroke.Color = Color3.fromRGB(80, 80, 95); prevStroke.Thickness = 2
            local arrow = Instance.new("TextLabel", f); arrow.Size = UDim2.new(0, 24, 0, 24); arrow.Position = UDim2.new(1, -24, 0, 14); arrow.BackgroundTransparency = 1; arrow.Text = "v"; arrow.Font = Enum.Font.GothamBold; arrow.TextSize = 12; arrow.TextColor3 = Color3.fromRGB(150, 150, 165); arrow.ZIndex = 12
