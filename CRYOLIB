            clickBtn.MouseButton1Click:Connect(function() if open then closeDropdown() else for _, dd in ipairs(libData.dropdowns) do if dd ~= ddData and dd.open then dd.close() end end; openDropdown() end end)
            local ddData = {open = false, listFrame = listFrame, buttonFrame = f, close = closeDropdown}
            table.insert(libData.dropdowns, ddData)
            return {GetSelected = function() return multiSelect and selected or selected end, SetSelected = function(v) if multiSelect then selected = type(v)=="table" and v or {v} else selected = v end; updateLabel(); updateItems() end}
        end

        return tabObj
    end

    function libData:GetToggle(name)
        for _, t in ipairs(libData.activeToggles) do if t.name == name then return t end end
        return nil
    end

    return libData
