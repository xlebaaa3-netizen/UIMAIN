-- ==================== CRYO LIBRARY (FIXED) ====================
local CryoLib = {}
CryoLib.__index = CryoLib

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function SafeCall(callback, ...)
	if type(callback) == "function" then
		local success, err = pcall(callback, ...)
		if not success then warn("[CryoLib] " .. tostring(err)) end
	end
end

local function SafeTween(instance, info, props)
	if not instance or not instance.Parent then return end
	local ok, tween = pcall(function()
		return TweenService:Create(instance, info, props)
	end)
	if ok then return tween end
end

-- ==================== CREATE WINDOW ====================
function CryoLib:CreateWindow(title)
	local self = setmetatable({}, CryoLib)

	self.tabs = {}
	self.currentTab = nil
	self.isOpen = false

	self.gui = Instance.new("ScreenGui")
	self.gui.Name = "CryoLibGUI"
	self.gui.ResetOnSpawn = false
	self.gui.Parent = PlayerGui

	self.mainPanel = Instance.new("Frame")
	self.mainPanel.Size = UDim2.new(0, 420, 0, 520)
	self.mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
	self.mainPanel.BackgroundColor3 = Color3.fromRGB(20,20,25)
	self.mainPanel.Visible = false
	self.mainPanel.Parent = self.gui

	self.header = Instance.new("TextLabel")
	self.header.Size = UDim2.new(1,0,0,50)
	self.header.BackgroundTransparency = 1
	self.header.Text = title or "Cryo"
	self.header.Parent = self.mainPanel

	self.scrollFrame = Instance.new("ScrollingFrame")
	self.scrollFrame.Size = UDim2.new(1, -10, 1, -60)
	self.scrollFrame.Position = UDim2.new(0,5,0,55)
	self.scrollFrame.CanvasSize = UDim2.new(0,0,0,0)
	self.scrollFrame.Parent = self.mainPanel

	local layout = Instance.new("UIListLayout")
	layout.Parent = self.scrollFrame

	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		self.scrollFrame.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y + 10)
	end)

	-- floating button (fixed)
	self.floatingBtn = Instance.new("TextButton")
	self.floatingBtn.Size = UDim2.new(0,50,0,50)
	self.floatingBtn.Position = UDim2.new(0,20,0.5,0)
	self.floatingBtn.Text = "UI"
	self.floatingBtn.Parent = self.gui

	local dragging = false
	local moved = false
	local start, pos

	self.floatingBtn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = false
			start = i.Position
			pos = self.floatingBtn.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = i.Position - start
			if delta.Magnitude > 5 then moved = true end

			self.floatingBtn.Position = UDim2.new(
				pos.X.Scale,
				pos.X.Offset + delta.X,
				pos.Y.Scale,
				pos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			if not moved then
				self:Toggle()
			end
		end
	end)

	return self
end

function CryoLib:Toggle()
	self.isOpen = not self.isOpen
	self.mainPanel.Visible = self.isOpen
end

-- ==================== TABS ====================
function CryoLib:AddTab(name)
	local tab = {elements = {}}
	table.insert(self.tabs, tab)

	if not self.currentTab then
		self.currentTab = tab
	end

	return {
		AddSection = function(_, title)
			local label = Instance.new("TextLabel")
			label.Text = title
			label.Size = UDim2.new(1,0,0,30)
			label.Parent = self.scrollFrame
			return {
				AddButton = function(_, text, cb)
					local b = Instance.new("TextButton")
					b.Text = text
					b.Size = UDim2.new(1,0,0,40)
					b.Parent = self.scrollFrame
					b.MouseButton1Click:Connect(function()
						SafeCall(cb)
					end)
				end
			}
		end
	}
end

return CryoLib
