local CryoLib = {}

function CryoLib:CreateWindow(hubName)
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = Players.LocalPlayer

    local libData = {
        currentTab = nil,
        tabs = {},
        states = {},
        accent = Color3.fromRGB(100, 150, 255)
    }

    -- [[ ОСНОВА GUI ]]
    local gui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
    gui.Name = "CryoLib_" .. math.random(100, 999)
    gui.ResetOnSpawn = false

    local mainPanel = Instance.new("Frame", gui)
    mainPanel.Size = UDim2.new(0, 420, 0, 520)
    mainPanel.Position = UDim2.new(0.5, -210, 0.5, -260)
    mainPanel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    mainPanel.ClipsDescendants = true
    mainPanel.Visible = true
    Instance.new("UICorner", mainPanel).CornerRadius = UDim.new(0, 20)
    
    local mainStroke = Instance.new("UIStroke", mainPanel)
    mainStroke.Color = Color3.fromRGB(45, 45, 55)
    mainStroke.Thickness = 2

    -- HEADER & DRAG
    local header = Instance.new("Frame", mainPanel)
    header.Size = UDim2.new(1, 0, 0, 50)
    header.BackgroundTransparency = 1

    local function makeDraggable(obj, parent)
        local dragging, input, startPos, startInput
        obj.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; startInput = i.Position; startPos = parent.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = i.Position - startInput
                parent.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    end
    makeDraggable(header, mainPanel)

    local headerIcon = Instance.new("ImageLabel", header)
    headerIcon.Size = UDim2.new(0, 25, 0, 25); headerIcon.Position = UDim2.new(0, 15, 0.5, -12); headerIcon.BackgroundTransparency = 1
    headerIcon.Image = "rbxassetid://104331218636380"

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(0, 200, 1, 0); title.Position = UDim2.new(0, 50, 0, 0); title.Text = hubName
    title.Font = "GothamBlack"; title.TextColor3 = Color3.new(1,1,1); title.BackgroundTransparency = 1; title.TextXAlignment = "Left"; title.TextSize = 18

    -- КНОПКИ УПРАВЛЕНИЯ
    local closeBtn = Instance.new("TextButton", header)
    closeBtn.Size = UDim2.new(0, 30, 0, 30); closeBtn.Position = UDim2.new(1, -40, 0, 10); closeBtn.Text = "×"
    closeBtn.TextColor3 = Color3.fromRGB(150, 150, 150); closeBtn.BackgroundTransparency = 1; closeBtn.Font = "GothamBlack"; closeBtn.TextSize = 24
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    -- КОНТЕЙНЕРЫ
    local tabContainer = Instance.new("Frame", mainPanel)
    tabContainer.Size = UDim2.new(0, 100, 1, -50); tabContainer.Position = UDim2.new(0, 0, 0, 50)
    tabContainer.BackgroundColor3 = Color3.fromRGB(12, 12, 16); tabContainer.BorderSizePixel = 0
    Instance.new("UICorner", tabContainer).CornerRadius = UDim.new(0, 20)
    
    local tabFix = Instance.new("Frame", tabContainer)
    tabFix.Size = UDim2.new(0.5, 0, 1, 0); tabFix.Position = UDim2.new(0.5, 0, 0, 0)
    tabFix.BackgroundColor3 = tabContainer.BackgroundColor3; tabFix.BorderSizePixel = 0

    local contentArea = Instance.new("Frame", mainPanel)
    contentArea.Size = UDim2.new(1, -100, 1, -50); contentArea.Position = UDim2.new(0, 100, 0, 50); contentArea.BackgroundTransparency = 1

    -- ФУНКЦИЯ СОЗДАНИЯ ВКЛАДКИ
    function libData:CreateTab(name)
        local tabObj = {}
        
        local btn = Instance.new("TextButton", tabContainer)
        btn.Size = UDim2.new(1, 0, 0, 40); btn.Position = UDim2.new(0, 0, 0, #libData.tabs * 42)
        btn.BackgroundTransparency = 1; btn.Text = name; btn.Font = "GothamBold"; btn.TextSize = 13; btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        
        local ind = Instance.new("Frame", btn); ind.Size = UDim2.new(0, 3, 0, 20); ind.Position = UDim2.new(0, 2, 0.5, -10)
        ind.BackgroundColor3 = libData.accent; ind.BackgroundTransparency = 1; Instance.new("UICorner", ind)

        local scrollFrame = Instance.new("ScrollingFrame", contentArea)
        scrollFrame.Size = UDim2.new(1, -20, 1, -20); scrollFrame.Position = UDim2.new(0, 10, 0, 10)
        scrollFrame.BackgroundTransparency = 1; scrollFrame.BorderSizePixel = 0; scrollFrame.ScrollBarThickness = 3
        scrollFrame.Visible = false; scrollFrame.ScrollBarImageColor3 = libData.accent

        local layout = Instance.new("UIListLayout", scrollFrame); layout.Padding = UDim.new(0, 8)
        layout.Changed:Connect(function() scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10) end)

        local function activate()
            for _, t in ipairs(libData.tabs) do
                t.btn.TextColor3 = Color3.fromRGB(150, 150, 150)
                t.ind.BackgroundTransparency = 1
                t.scroll.Visible = false
            end
            btn.TextColor3 = Color3.new(1,1,1)
            ind.BackgroundTransparency = 0
            scrollFrame.Visible = true
        end

        btn.MouseButton1Click:Connect(activate)
        table.insert(libData.tabs, {btn = btn, ind = ind, scroll = scrollFrame})
        
        if #libData.tabs == 1 then activate() end

        -- [[ ЭЛЕМЕНТЫ ВКЛАДКИ ]]
        
        function tabObj:CreateLabel(text)
            local l = Instance.new("TextLabel", scrollFrame)
            l.Size = UDim2.new(1, -5, 0, 25)
            l.BackgroundTransparency = 1
            l.Text = text
            l.TextColor3 = libData.accent
            l.Font = "GothamBold"
            l.TextSize = 14
            l.TextXAlignment = Enum.TextXAlignment.Left
            return l
        end

        function tabObj:CreateButton(text, callback)
            local b = Instance.new("TextButton", scrollFrame)
            b.Size = UDim2.new(1, -5, 0, 40); b.BackgroundColor3 = libData.accent; b.Text = text
            b.Font = "GothamBlack"; b.TextColor3 = Color3.new(1,1,1); b.TextSize = 14
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
            b.MouseButton1Click:Connect(callback)
            return b
        end

        function tabObj:CreateToggle(text, callback)
            local state = false
            local f = Instance.new("Frame", scrollFrame); f.Size = UDim2.new(1, -5, 0, 45); f.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
            
            local l = Instance.new("TextLabel", f); l.Size = UDim2.new(1, -60, 1, 0); l.Position = UDim2.new(0, 12, 0, 0)
            l.Text = text; l.Font = "GothamBold"; l.TextColor3 = Color3.new(1,1,1); l.BackgroundTransparency = 1; l.TextXAlignment = "Left"
            
            local bg = Instance.new("Frame", f); bg.Size = UDim2.new(0, 38, 0, 20); bg.Position = UDim2.new(1, -48, 0.5, -10)
            bg.BackgroundColor3 = Color3.fromRGB(45, 45, 55); Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
            
            local c = Instance.new("Frame", bg); c.Size = UDim2.new(0, 16, 0, 16); c.Position = UDim2.new(0, 2, 0.5, -8)
            c.BackgroundColor3 = Color3.new(1,1,1); Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
            
            local clicker = Instance.new("TextButton", f)
            clicker.Size = UDim2.new(1, 0, 1, 0)
            clicker.BackgroundTransparency = 1
            clicker.Text = ""
            
            clicker.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(bg, TweenInfo.new(0.3), {BackgroundColor3 = state and libData.accent or Color3.fromRGB(45, 45, 55)}):Play()
                TweenService:Create(c, TweenInfo.new(0.3), {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                callback(state)
            end)
            return f
        end

        function tabObj:CreateSlider(text, min, max, default, callback)
            local val = default
            local f = Instance.new("Frame", scrollFrame); f.Size = UDim2.new(1, -5, 0, 60); f.BackgroundColor3 = Color3.fromRGB(25, 25, 32); Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
            
            local l = Instance.new("TextLabel", f); l.Size = UDim2.new(1, -20, 0, 20); l.Position = UDim2.new(0, 12, 0, 8)
            l.Text = text..": "..val; l.Font = "GothamBold"; l.TextColor3 = Color3.new(1,1,1); l.BackgroundTransparency = 1; l.TextXAlignment = "Left"
            
            local t = Instance.new("Frame", f); t.Size = UDim2.new(1, -30, 0, 6); t.Position = UDim2.new(0, 15, 0, 38)
            t.BackgroundColor3 = Color3.fromRGB(40, 40, 45); Instance.new("UICorner", t)
            
            local fill = Instance.new("Frame", t); fill.Size = UDim2.new((val-min)/(max-min), 0, 1, 0)
            fill.BackgroundColor3 = libData.accent; Instance.new("UICorner", fill)
            
            local function update()
                local m = math.clamp((UserInputService:GetMouseLocation().X - t.AbsolutePosition.X) / t.AbsoluteSize.X, 0, 1)
                val = math.floor(min + (m * (max - min)))
                l.Text = text..": "..val; fill.Size = UDim2.new(m, 0, 1, 0)
                callback(val)
            end
            
            t.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    update()
                    local move; move = UserInputService.InputChanged:Connect(function(ev)
                        if ev.UserInputType == Enum.UserInputType.MouseMovement then update() end
                    end)
                    UserInputService.InputEnded:Connect(function(ev)
                        if ev.UserInputType == Enum.UserInputType.MouseButton1 then move:Disconnect() end
                    end)
                end
            end)
            return f
        end

        return tabObj
    end

    return libData
end

return CryoLib -- ГАРАНТИРУЕТ, ЧТО loadstring ВЕРНЕТ ТАБЛИЦУ
