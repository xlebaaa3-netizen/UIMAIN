            local hexLabel = Instance.new("TextLabel", sliderContainer); hexLabel.Size = UDim2.new(0, 80, 0, 20); hexLabel.Position = UDim2.new(0.5, -40, 0, 100); hexLabel.BackgroundColor3 = Color3.fromRGB(35, 35, 45); hexLabel.Text = string.format("#%02X%02X%02X", r, g, b); hexLabel.Font = Enum.Font.GothamBold; hexLabel.TextSize = 11; hexLabel.TextColor3 = Color3.fromRGB(200, 200, 200); hexLabel.ZIndex = 13
